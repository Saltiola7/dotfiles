<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>dev.dotfiles.deskflow-server</string>
<key>LimitLoadToSessionType</key><string>Aqua</string>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ProcessType</key><string>Interactive</string>
<key>ProgramArguments</key>
<array>
<string>/Applications/Deskflow.app/Contents/MacOS/deskflow-core</string>
<string>server</string>
<string>-s</string>
<string>{{ .chezmoi.homeDir }}/Library/Deskflow/deskflow-core.conf</string>
</array>
<key>StandardOutPath</key><string>/tmp/deskflow-core.log</string>
<key>StandardErrorPath</key><string>/tmp/deskflow-core.log</string>
</dict></plist>
