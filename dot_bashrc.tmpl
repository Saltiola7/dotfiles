{{ if or (eq .machine_type "omarchy") (eq .machine_type "omarchy-try") -}}
# Keep Omarchy's shell integrations, then select the chezmoi-managed agents.
[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap
export PATH="$HOME/.local/bin:$PATH"
for agent in codex opencode herdr wt; do
    if [[ -x "$HOME/.local/bin/$agent" ]]; then
        case "$agent" in
            # The packaged Codex CLI has no background daemon; --no-daemon is the supported mode.
            codex) codex() { "$HOME/.local/bin/codex" --no-daemon "$@"; } ;;
            opencode) opencode() { "$HOME/.local/bin/opencode" "$@"; } ;;
            herdr) herdr() { "$HOME/.local/bin/herdr" "$@"; } ;;
            wt) wt() { "$HOME/.local/bin/wt" "$@"; } ;;
        esac
    fi
done
unset agent
[[ $- != *i* ]] && return
source "$OMARCHY_PATH/default/bash/rc"
# Shell tooling hooks load before ble.sh: fzf's bash hook binds with
# readline-8.1 directives (emacs/vi-editing-mode) that ble.sh's bind
# emulation rejects with a warning each; before ble they hit real
# readline silently. atuin/direnv register precmd hooks, no binds.
[ -x "$(command -v direnv)" ] && eval "$(direnv hook bash)"
[ -x "$(command -v fzf)" ] && source <(fzf --bash)
# ble.sh after all plain-readline setup, same reason as the hooks above.
if [[ -z ${BLE_VERSION-} && -r "$HOME/.local/share/blesh/ble.sh" ]]; then
    source "$HOME/.local/share/blesh/ble.sh" --noattach
fi
# Mise changes PATH on each prompt; the functions above keep agent ownership stable.
export PATH="$HOME/.local/bin:$PATH"

# Render the starship prompt into PS1 BEFORE ble-attach: ble captures
# PS1 at attach time, and Omarchy's minimal prompt (~ ❯) is starship
# driven, so starship must have drawn once by then or ble adopts the
# raw fallback prompt.
if command -v starship >/dev/null && [[ $TERM != "dumb" ]]; then
    eval "$(starship init bash)"
    starship_precmd 2>/dev/null || true
fi
[[ ${BLE_VERSION-} ]] && ble-attach
# atuin LAST: its ctrl-r and up-arrow binds must be the final word —
# after fzf (which would otherwise own ctrl-r) and after ble-attach
# (so ble adopts atuin's bindings rather than replacing them).
[ -x "$(command -v atuin)" ] && eval "$(atuin-init-bash)"
{{ if and (eq .machine_type "omarchy-try") (eq .chezmoi.os "linux") -}}
{{ include ".chezmoitemplates/omarchy-herdr-shell-start.sh" }}
{{ end -}}
{{ else -}}
# --- Source Common Configuration ---
if [ -f "$HOME/.common_profile" ]; then
    . "$HOME/.common_profile"
fi

# Everything below is interactive-only (skip for bash -l -c "..." contexts)
[[ $- != *i* ]] && return

{{ if or (eq .machine_type "lmsh") (eq .machine_type "fedora-server") -}}
if [ -z "$INTELLIJ_ENVIRONMENT_READER" ] && [ -t 0 ]; then
    command -v atuin >/dev/null && eval "$(atuin init bash)"
    command -v zoxide >/dev/null && eval "$(zoxide init bash)"
{{ if eq .machine_type "fedora-server" -}}
    command -v direnv >/dev/null && eval "$(direnv hook bash)"
{{ end -}}
    if command -v starship >/dev/null; then
        export SHELL_LABEL="bash ${BASH_VERSION%%(*}"
        eval "$(starship init bash)"
    fi
fi
if command -v atuin >/dev/null && [ -t 0 ]; then
    bind '"\e[A": "\eOA"'
fi
{{ else -}}
# --- ble.sh early init (must come before oh-my-bash) ---
# Provides autosuggestions, syntax highlighting, enhanced completion
if [ -z "$INTELLIJ_ENVIRONMENT_READER" ]; then
    [[ -f "$HOME/.local/share/blesh/ble.sh" ]] && source "$HOME/.local/share/blesh/ble.sh" --noattach
fi

# --- Oh My Bash ---
export OSH="$HOME/.oh-my-bash"

# Theme: empty because starship handles the prompt
OSH_THEME=""

completions=(
    git
    composer
    ssh
)
aliases=(
    general
)
plugins=(
    git
    bashmarks
)

if [ -z "$INTELLIJ_ENVIRONMENT_READER" ]; then
    source "$OSH/oh-my-bash.sh"
    unset -f mo 2>/dev/null  # oh-my-bash ships Mustache engine as mo(); remove so Mole CLI works
fi

# --- Tool integrations (guarded from IntelliJ terminal scanner) ---
if [ -z "$INTELLIJ_ENVIRONMENT_READER" ]; then
    # Google Cloud SDK completions
    [ -f "$HOME/google-cloud-sdk/completion.bash.inc" ] && . "$HOME/google-cloud-sdk/completion.bash.inc"

    # Atuin (shell history)
    [ -x "$(command -v atuin)" ] && eval "$(atuin init bash)"

    # Direnv (per-directory env)
    eval "$(direnv hook bash)"

    # Zoxide (smart cd)
    eval "$(zoxide init bash)"

    # Mise (runtime version manager)
    eval "$(mise activate bash)"

    # Carapace (completion engine)
    source <(carapace _carapace)

    # fzf (fuzzy finder)
    [ -f ~/.fzf.bash ] && source ~/.fzf.bash

    # Starship prompt (overrides oh-my-bash prompt)
    export SHELL_LABEL="bash ${BASH_VERSION%%(*}"
    eval "$(starship init bash)"
fi

# --- Bash Preexec ---
[[ -f ~/.bash-preexec.sh ]] && source ~/.bash-preexec.sh

# Fix: Force Up Arrow to trigger Atuin (maps standard Up to Application Up)
bind '"\e[A": "\eOA"'

# --- ble.sh late attach (must come last) ---
if [ -z "$INTELLIJ_ENVIRONMENT_READER" ]; then
    [[ ${BLE_VERSION-} ]] && ble-attach
fi
{{ end -}}
{{ end -}}
