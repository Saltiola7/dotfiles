{
  "schema_version": 1,
  "id": "personal-homelab",
  "title": "Personal homelab topology and Raspberry Pi bootstrap",
  "state": "building",
  "coordinator_repository": "Saltiola7/dotfiles",
  "statements": [
    {
      "id": "INT-001",
      "kind": "requirement",
      "text": "Maintain a personal homelab inventory covering physical machines, virtual machines, containers, storage and access dependencies.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_topology/README.md"
      ]
    },
    {
      "id": "INT-002",
      "kind": "constraint",
      "text": "External and work systems are separate dependencies and are not administered by this initiative.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_topology/README.md"
      ]
    },
    {
      "id": "INT-003",
      "kind": "requirement",
      "text": "Declare development targets, architecture, purpose, configuration owner and access method before moving workloads.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_topology/README.md"
      ]
    },
    {
      "id": "INT-004",
      "kind": "non-goal",
      "text": "Do not move workloads, change existing hosting or select automatic failover in the first delivery.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_topology/README.md"
      ]
    },
    {
      "id": "INT-005",
      "kind": "requirement",
      "text": "Produce a readable topology diagram and equivalent inventory from authoritative declarations.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_topology/README.md"
      ]
    },
    {
      "id": "INT-006",
      "kind": "constraint",
      "text": "Distinguish owner declarations, observations, desired state, unknowns and stale information.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_topology/README.md"
      ]
    },
    {
      "id": "INT-007",
      "kind": "decision",
      "text": "Use separate topology and Raspberry Pi bootstrap bounded contexts in the dotfiles repository.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_topology/README.md"
      ]
    },
    {
      "id": "INT-008",
      "kind": "requirement",
      "text": "Include the owner-reported MacBook Pro with M1 processor, 16 GB memory and 512 GB storage; do not infer its remote identity.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_topology/README.md"
      ]
    },
    {
      "id": "INT-009",
      "kind": "requirement",
      "text": "Bootstrap Raspberry Pi 400 as a headless Fedora Minimal server over Ethernet using an external SSD as its system disk.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/raspberry_pi_bootstrap/README.md"
      ]
    },
    {
      "id": "INT-010",
      "kind": "constraint",
      "text": "Preparation is launched from a maintained macOS script using the existing personal Lima Fedora VM; existing Parallels guests are excluded and existing services must remain unchanged.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/raspberry_pi_bootstrap/README.md"
      ]
    },
    {
      "id": "INT-011",
      "kind": "requirement",
      "text": "Declare image identity, integrity verification, user, public-key SSH, network policy and recovery in reproducible source.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/raspberry_pi_bootstrap/README.md"
      ]
    },
    {
      "id": "INT-012",
      "kind": "constraint",
      "text": "Disk flashing is an explicitly invoked provisioning operation with fresh target verification and approval, never a chezmoi apply hook.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/raspberry_pi_bootstrap/README.md"
      ]
    },
    {
      "id": "INT-013",
      "kind": "decision",
      "text": "Existing flashed state need not be preserved; the owner reports no SSD data to preserve. This does not waive target-specific erase approval.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/raspberry_pi_bootstrap/README.md"
      ]
    },
    {
      "id": "INT-014",
      "kind": "requirement",
      "text": "Use owner user tis and existing Mac public SSH key; do not copy private keys or enable password SSH.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/raspberry_pi_bootstrap/README.md"
      ]
    },
    {
      "id": "INT-015",
      "kind": "requirement",
      "text": "Establish local Ethernet SSH before interactive Tailscale enrollment; never commit enrollment credentials or node state.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/raspberry_pi_bootstrap/README.md"
      ]
    },
    {
      "id": "INT-016",
      "kind": "risk",
      "text": "USB boot history is unknown and no spare microSD recovery medium is available. A firmware or USB boot failure may require obtaining recovery media.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/raspberry_pi_bootstrap/README.md"
      ]
    },
    {
      "id": "INT-017",
      "kind": "non-goal",
      "text": "Application and workload configuration are deferred until the initial headless boot and administration path work.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/raspberry_pi_bootstrap/README.md"
      ]
    },
    {
      "id": "INT-018",
      "kind": "constraint",
      "text": "Existing personal and AI configuration sources retain their target ownership; bootstrap must not introduce overlapping managed files.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/raspberry_pi_bootstrap/README.md"
      ]
    },
    {
      "id": "INT-019",
      "kind": "constraint",
      "text": "Inventory includes personal infrastructure and excludes phones and tablets.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_topology/README.md"
      ]
    },
    {
      "id": "INT-020",
      "kind": "constraint",
      "text": "Commit public-safe logical identities, roles and relationships; private endpoints, remote identities, serials and credentials remain in a local private overlay.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_topology/README.md"
      ]
    },
    {
      "id": "INT-021",
      "kind": "decision",
      "text": "Pi is the always-on primary ordinary-folder file server with authenticated Samba access privately over Tailscale.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_file_storage/README.md"
      ]
    },
    {
      "id": "INT-022",
      "kind": "requirement",
      "text": "Store encrypted versioned Borg backups in a dedicated folder on the existing Mac-connected external disk, then verify existing Backblaze protection independently.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_backup/README.md"
      ]
    },
    {
      "id": "INT-023",
      "kind": "constraint",
      "text": "Preserve existing HP and Mac shares, backup repositories, services and disks; no formatting or source-data migration.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_backup/README.md"
      ]
    },
    {
      "id": "INT-024",
      "kind": "decision",
      "text": "Connected-only access is sufficient; offline synchronization and Baserow are deferred.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_file_storage/README.md"
      ]
    },
    {
      "id": "INT-025",
      "kind": "requirement",
      "text": "Deploy private RustFS on Pi for DVC/S3 development using isolated object data, verified ARM64 release, private credentials and bounded resources.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_object_storage/README.md"
      ]
    },
    {
      "id": "INT-026",
      "kind": "requirement",
      "text": "Add consistent frozen RustFS data and private credential backups to the existing encrypted Borg repository, with isolated S3 restore verification and original service-state recovery.",
      "disposition": "ready",
      "artifacts": [
        "docs/specs/homelab_backup/README.md",
        "docs/specs/homelab_object_storage/README.md"
      ]
    }
  ],
