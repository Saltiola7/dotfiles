# Reviewed copy of AUR espanso-wayland (commit 5e7d5a671121) raised to v2.4.1 so the
# ARM64 Wayland guest builds its native package. Upstream maintainers: Carl
# Smedstad, Hauke Ingwersen, Sefa Eyeoglu. chezmoi owns the graphical user
# service, so no unit, desktop file or icon is packaged here.
pkgname=espanso-wayland
_name=espanso
pkgver=2.4.1
pkgrel=1
pkgdesc="Cross-platform Text Expander written in Rust (built for Wayland)"
arch=(aarch64)
url="https://github.com/espanso/espanso"
license=(GPL-3.0-only)
depends=(
  bzip2
  dbus
  gcc-libs
  glibc
  libxkbcommon
  openssl
  wl-clipboard
  wxwidgets-common
  wxwidgets-gtk3
)
makedepends=(cargo)
provides=(espanso)
conflicts=(espanso)
options=(!lto)
install=espanso-wayland.install

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('3121627138be4b1f106b8dfd73fb4b7030ecb44c6a8f4e7628a1174b58e5cfe2')

_archive="$_name-$pkgver"

prepare() {
  cd "$_archive"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_archive"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release \
    --features wayland \
    --manifest-path espanso/Cargo.toml \
    --package espanso
}

package() {
  cd "$_archive"
  install -Dm755 -t "$pkgdir/usr/bin" target/release/espanso
}
