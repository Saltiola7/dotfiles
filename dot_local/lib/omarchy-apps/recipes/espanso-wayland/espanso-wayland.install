# Espanso's unprivileged Wayland model: the binary itself carries the capability
# to read /dev/input and open /dev/uinput. The daemon never runs as root, and
# child processes started by match variables do not inherit the capability.
post_install() {
  setcap "cap_dac_override+p" /usr/bin/espanso
}

post_upgrade() {
  post_install "$1"
}
