[Desktop Entry]
Version=1.0
Type=Application
Name=Zen Browser
Comment=Browse with the managed Omarchy profile
Exec="{{ .chezmoi.homeDir }}/.local/bin/omarchy-zen-launch" %u
Icon=zen-browser
Terminal=false
Categories=Network;WebBrowser;
StartupWMClass=zen
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec="{{ .chezmoi.homeDir }}/.local/bin/omarchy-zen-launch" --new-window

[Desktop Action new-private-window]
Name=New Private Window
Exec="{{ .chezmoi.homeDir }}/.local/bin/omarchy-zen-launch" --private-window
