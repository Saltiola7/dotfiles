[Desktop Entry]
Version=1.0
Type=Application
Name=Zen Browser
{{ if eq .machine_type "omarchy-try" -}}
Comment=Browse the web
Exec={{ .chezmoi.homeDir }}/.local/bin/zen %u
{{- else -}}
Comment=Browse with the managed Omarchy profile
Exec={{ .chezmoi.homeDir }}/.local/bin/omarchy-zen-launch %u
{{- end }}
Icon=zen-browser
Terminal=false
Categories=Network;WebBrowser;
StartupWMClass=zen
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
{{ if eq .machine_type "omarchy-try" -}}
Exec={{ .chezmoi.homeDir }}/.local/bin/zen --new-window
{{- else -}}
Exec={{ .chezmoi.homeDir }}/.local/bin/omarchy-zen-launch --new-window
{{- end }}

[Desktop Action new-private-window]
Name=New Private Window
{{ if eq .machine_type "omarchy-try" -}}
Exec={{ .chezmoi.homeDir }}/.local/bin/zen --private-window
{{- else -}}
Exec={{ .chezmoi.homeDir }}/.local/bin/omarchy-zen-launch --private-window
{{- end }}
