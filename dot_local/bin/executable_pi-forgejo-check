#!/usr/bin/env python3
"""Isolated private Git and encrypted Borg/Forgejo recovery drill."""
import configparser
import hashlib
import json
import os
from pathlib import Path
import secrets
import shutil
import socket
import subprocess
import tempfile
import time
import urllib.request
import urllib.error

SHA='be06bb887bef8a7901c6bdcea36023e55429ef7582a2797711b878a3af602e69'


def api(endpoint: str, token: str, path: str, method: str='GET', data=None):
    request=urllib.request.Request(endpoint+'/api/v1'+path,data=json.dumps(data).encode() if data is not None else None,method=method,headers={'Authorization':'token '+token,'Content-Type':'application/json'})
    with urllib.request.urlopen(request,timeout=30) as r:
        body=r.read();return json.loads(body) if body else None


def prefix(root: Path) -> list[str]:
    return [str(Path.home()/'.local/bin/forgejo'),'-w',str(root),'-c',str(root/'private/app.ini')]


def trust(root: Path, port: int, target: Path) -> None:
    # Bind scanned public keys to keys generated in this owned Forgejo data tree.
    scanned=subprocess.check_output(['ssh-keyscan','-p',str(port),'-t','ed25519,rsa','127.0.0.1'],stderr=subprocess.DEVNULL,text=True)
    public=[]
    for p in (root/'ssh').rglob('*'):
        if p.is_file() and not p.name.endswith('.pub'):
            r=subprocess.run(['ssh-keygen','-y','-f',str(p)],capture_output=True,text=True)
            if r.returncode==0:public.append(' '.join(r.stdout.split()[:2]))
    accepted=[line for line in scanned.splitlines() if ' '.join(line.split()[1:3]) in public]
    if not accepted:raise ValueError('Forgejo host key did not match owned source')
    target.write_text('\n'.join(accepted)+'\n');target.chmod(0o600)


def git_env(temp: Path, port: int) -> dict:
    env=dict(os.environ)
    env.update(GIT_CONFIG_GLOBAL='/dev/null',GIT_CONFIG_SYSTEM='/dev/null',GIT_TERMINAL_PROMPT='0',GIT_SSH_COMMAND=f'ssh -F /dev/null -i {temp}/identity -p {port} -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o GlobalKnownHostsFile=/dev/null -o UserKnownHostsFile={temp}/known_hosts')
    return env


def run(*args: str, env=None, cwd=None) -> None:
    subprocess.run(args,check=True,env=env,cwd=cwd,stdout=subprocess.DEVNULL,stderr=subprocess.PIPE)


def ready(endpoint: str) -> None:
    for _ in range(100):
        try:
            urllib.request.urlopen(endpoint+'/api/healthz',timeout=2);return
        except OSError:time.sleep(.3)
    raise ValueError('Isolated Forgejo readiness failed')


def main() -> None:
    os.umask(0o077);home=Path.home();root=home/'.local/share/forgejo';backup=home/'.local/bin/homelab-backup';client=home/'.config/homelab-backup/client.json'
    name='verify-'+secrets.token_hex(8);repo='probe';endpoint='http://127.0.0.1:3000';created=False;repo_created=False;token=None
    with tempfile.TemporaryDirectory(prefix='forgejo-recovery-') as directory:
        temp=Path(directory)
        try:
            # CLI produces secrets only into captured memory, never tools or process arguments.
            subprocess.run(prefix(root)+['admin','user','create','--username',name,'--email',name+'@localhost','--admin','--random-password','--must-change-password=false'],check=True,capture_output=True)
            created=True
            token=subprocess.check_output(prefix(root)+['admin','user','generate-access-token','--username',name,'--token-name','isolated-recovery','--scopes','all','--raw'],text=True).strip()
            run('ssh-keygen','-q','-t','ed25519','-N','','-f',str(temp/'identity'))
            pub=(temp/'identity.pub').read_text().strip();api(endpoint,token,'/user/keys','POST',{'title':'isolated-probe','key':pub})
            api(endpoint,token,'/user/repos','POST',{'name':repo,'private':True});repo_created=True
            trust(root,2222,temp/'known_hosts');env=git_env(temp,2222)
            live=temp/'live';run('git','clone',f'ssh://{home.name}@127.0.0.1:2222/{name}/{repo}.git',str(live),env=env)
            payload=secrets.token_bytes(4096);(live/'proof.bin').write_bytes(payload)
            run('git','add','proof.bin',cwd=live,env=env)
            run('git','-c','user.name=Recovery Probe','-c','user.email=probe@localhost','commit','-m','Isolated recovery proof',cwd=live,env=env)
            run('git','push','origin','HEAD',cwd=live,env=env)
            branch=subprocess.check_output(['git','branch','--show-current'],cwd=live,text=True).strip()
            run(str(backup),'forgejo-enable','--config',str(client))
            run(str(backup),'archive-check','--config',str(client))
            receipt=json.loads((home/'.local/state/homelab-backup/last-success.json').read_text());source=receipt['forgejo_source']
            cfg=json.loads(client.read_text());env_borg={k:v for k,v in os.environ.items() if not k.startswith('BORG_')}
            env_borg['BORG_PASSPHRASE']=Path(cfg['password_file']).read_text().strip()
            import shlex
            env_borg['BORG_RSH']=shlex.join(['ssh','-F','/dev/null','-i',cfg['identity_file'],'-o','IdentitiesOnly=yes','-o','BatchMode=yes','-o','StrictHostKeyChecking=yes','-o','GlobalKnownHostsFile=/dev/null','-o','UserKnownHostsFile='+cfg['known_hosts']])
            restored=temp/'restore';restored.mkdir()
            run('borg','extract',cfg['repository']+'::'+receipt['archive'],source.lstrip('/'),env=env_borg,cwd=restored)
            bundle=restored/source.lstrip('/');manifest=json.loads((bundle/'capture.json').read_text())
            if manifest['binary_sha256']!=SHA:raise ValueError('Restored Forgejo identity changed')
            for relative,expected in manifest['files'].items():
                path=bundle/relative
                if not path.resolve().is_relative_to(bundle.resolve()) or path.is_symlink():raise ValueError('Invalid restored path')
                with path.open('rb') as stream:
                    if hashlib.file_digest(stream,'sha256').hexdigest()!=expected:raise ValueError('Restored Forgejo bytes differ')
            app=bundle/'forgejo';config=app/'private/app.ini';text=config.read_text().replace(manifest['original_root'],str(app))
            text=text.replace('HTTP_PORT = 3000','HTTP_PORT = 13000').replace('SSH_PORT = 2222','SSH_PORT = 12222').replace('SSH_LISTEN_PORT = 2222','SSH_LISTEN_PORT = 12222')
            lines=text.splitlines();lines=['ROOT_URL = http://127.0.0.1:13000/' if line.startswith('ROOT_URL =') else line for line in lines];config.write_text('\n'.join(lines)+'\n')
            for port in (13000,12222):
                with socket.socket() as sock:sock.bind(('127.0.0.1',port))
            unit='forgejo-restore-'+secrets.token_hex(8)
            try:
                run('systemd-run','--user','--unit='+unit,'-p','CPUQuota=50%','-p','MemoryMax=768M','-p','MemorySwapMax=0','-p','UMask=0077',str(bundle/'forgejo-binary'),'-w',str(app),'-c',str(config),'web')
                ready('http://127.0.0.1:13000')
                info=api('http://127.0.0.1:13000',token,'/repos/'+name+'/'+repo)
                if not info['private']:raise ValueError('Restored repo privacy differs')
                try:
                    urllib.request.urlopen('http://127.0.0.1:13000/api/v1/repos/'+name+'/'+repo)
                    raise ValueError('Anonymous private repository metadata allowed')
                except urllib.error.HTTPError as error:
                    if error.code not in (401,403,404):raise
                trust(app,12222,temp/'known_hosts');recovered=temp/'recovered'
                run('git','clone','--branch',branch,f'ssh://{home.name}@127.0.0.1:12222/{name}/{repo}.git',str(recovered),env=git_env(temp,12222))
                if (recovered/'proof.bin').read_bytes()!=payload:raise ValueError('Restored Git bytes differ')
            finally:run('systemctl','--user','stop',unit)
            (home/'.local/state/homelab-backup/forgejo-restore-verified').write_text(SHA+'\n')
            print('Private Git push and encrypted Forgejo recovery matched; anonymous access denied.')
        finally:
            if created:
                # Deletes only this generated probe repository/account, preserving all owner data.
                if repo_created:api(endpoint,token,'/repos/'+name+'/'+repo,'DELETE')
                run(*prefix(root),'admin','user','delete','--username',name)


if __name__=='__main__':main()
