#!/usr/bin/env python3
"""Fast-forward the enrolled private Espanso checkout and deploy its reviewed match YAML.

One-way: private Git to the live match directory. Never pushes, merges, resets or
prints file contents. Exit 0 for a complete sync, 1 for an incomplete one.
"""
from __future__ import annotations

import argparse
import contextlib
import fcntl
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

MATCH_TREE = 'espanso/match'
LEAF_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]*\.ya?ml\Z')
MAX_LEAF_BYTES = 1024 * 1024
GIT_TIMEOUT = 120
CHEZMOI_TIMEOUT = 60
CONFIG_FORMATS = ('.toml', '.json', '.yaml', '.yml')
# chezmoi's error text quotes file content, so only the exit status is kept.
YAML_PROBE = ('{{ $document := fromYaml (output "cat" "--" %s) }}'
              '{{ if $document }}{{ if not (kindIs "map" $document) }}'
              '{{ fail "not a mapping" }}{{ end }}{{ end }}ok')
INTERRUPTED = ('MERGE_HEAD', 'CHERRY_PICK_HEAD', 'REVERT_HEAD', 'rebase-merge', 'rebase-apply',
               'BISECT_LOG')


class Refused(Exception):
    """An incomplete sync; carries a reason code and leaf names, never values."""

    def __init__(self, reason: str, *leaves: str) -> None:
        super().__init__(reason)
        self.reason = reason
        self.leaves = leaves


def git(checkout: Path, *args: str) -> subprocess.CompletedProcess:
    # Drop repository-selection variables so an enclosing Git context cannot retarget calls.
    environment = {key: value for key, value in os.environ.items()
                   if key not in ('GIT_DIR', 'GIT_WORK_TREE', 'GIT_INDEX_FILE')}
    return subprocess.run(
        ['git', '--no-optional-locks', '-C', str(checkout), *args],
        capture_output=True, stdin=subprocess.DEVNULL, timeout=GIT_TIMEOUT,
        env={**environment, 'GIT_TERMINAL_PROMPT': '0'},
    )


def text_of(result: subprocess.CompletedProcess) -> str:
    return result.stdout.decode('utf-8', 'replace').strip()


def normalize_origin(url: str) -> str:
    """Reduce a Git URL to its host/path identity; a local path resolves to its real path."""
    url = url.strip()
    if '://' in url:
        host, _, path = url.split('://', 1)[1].partition('/')
    elif re.fullmatch(r'[^/@]+@[^/:]+:.+', url):
        host, _, path = url.partition('@')[2].partition(':')
    else:
        return os.path.realpath(url)
    path = re.sub(r'\.git$', '', re.sub(r'/+$', '', '/' + path.lstrip('/')))
    return host.rpartition('@')[2].lower() + path


def validate_checkout(checkout: Path, origin: str) -> None:
    top = git(checkout, 'rev-parse', '--show-toplevel')
    if top.returncode != 0 or Path(text_of(top)).resolve() != checkout.resolve():
        raise Refused('checkout-unavailable')
    if git(checkout, 'symbolic-ref', '--quiet', '--short', 'HEAD').returncode != 0:
        raise Refused('detached-head')
    if git(checkout, 'rev-parse', '--abbrev-ref', '--symbolic-full-name', '@{u}').returncode != 0:
        raise Refused('no-upstream')
    configured = git(checkout, 'config', '--get', 'remote.origin.url')
    if configured.returncode != 0 or \
            normalize_origin(text_of(configured)) != normalize_origin(origin):
        raise Refused('unknown-origin')
    if text_of(git(checkout, 'status', '--porcelain', '--untracked-files=no')):
        raise Refused('dirty-checkout')
    git_dir = Path(text_of(git(checkout, 'rev-parse', '--absolute-git-dir')))
    if any((git_dir / marker).exists() for marker in INTERRUPTED):
        raise Refused('in-progress-operation')


def fast_forward(checkout: Path) -> None:
    try:
        if git(checkout, 'fetch', '--quiet', 'origin').returncode != 0:
            raise Refused('unreachable')
        merged = git(checkout, 'merge', '--ff-only', '--quiet', '@{u}')
    except subprocess.TimeoutExpired:
        raise Refused('unreachable') from None
    if merged.returncode != 0:
        ancestor = git(checkout, 'merge-base', '--is-ancestor', 'HEAD', '@{u}')
        raise Refused('diverged' if ancestor.returncode == 1 else 'unowned-collision')


def incoming_leaves(checkout: Path, revision: str) -> dict[str, bytes]:
    """Read the top-level match tree; anything but a plain YAML blob refuses the sync."""
    blobs = {}
    # The trailing slash lists the tree's children; a missing tree or a blob named "match" is empty.
    for line in text_of(git(checkout, 'ls-tree', revision, '--', MATCH_TREE + '/')).splitlines():
        meta, _, path = line.partition('\t')
        mode, _, blob = meta.split()
        name = path.rpartition('/')[-1]
        if not LEAF_NAME.fullmatch(name) or mode != '100644':
            raise Refused('invalid-scope', name)
        blobs[name] = blob
    if not blobs:
        raise Refused('invalid-scope')
    leaves = {}
    for name, blob in blobs.items():
        size = git(checkout, 'cat-file', '-s', blob)
        content = git(checkout, 'cat-file', 'blob', blob)
        if size.returncode != 0 or content.returncode != 0 or int(text_of(size)) > MAX_LEAF_BYTES:
            raise Refused('invalid-scope', name)
        leaves[name] = content.stdout
    return leaves


def deployed_leaves(checkout: Path, state_dir: Path) -> dict[str, bytes]:
    """Content of every leaf the last sync deployed, read from its recorded revision."""
    state_file = state_dir / 'state.json'
    if not state_file.exists():
        return {}
    state = json.loads(state_file.read_text())
    deployed = {}
    for name in state.get('leaves', []):
        blob = git(checkout, 'show', f"{state.get('revision', '')}:{MATCH_TREE}/{name}")
        if not LEAF_NAME.fullmatch(name) or blob.returncode != 0:
            raise Refused('checkout-unavailable')
        deployed[name] = blob.stdout
    return deployed


def regular_file(path: Path) -> bool:
    try:
        return stat.S_ISREG(path.lstat().st_mode)
    except FileNotFoundError:
        return False


def build_plan(match_dir: Path, incoming: dict[str, bytes], deployed: dict[str, bytes]
               ) -> tuple[dict[str, bytes], list[str], list[str]]:
    """Return (leaves to write, deployed leaves to remove, identical unowned leaves to adopt)."""
    writes: dict[str, bytes] = {}
    adopted: list[str] = []
    for name, content in incoming.items():
        live = match_dir / name
        if not live.exists() and not live.is_symlink():
            writes[name] = content
        elif not regular_file(live):
            raise Refused('non-regular-live-file', name)
        elif name in deployed:
            if live.read_bytes() != deployed[name]:
                raise Refused('local-edit', name)
            if live.read_bytes() != content:
                writes[name] = content
        elif live.read_bytes() == content:
            adopted.append(name)
        else:
            raise Refused('unowned-collision', name)
    removes = []
    for name in deployed:
        live = match_dir / name
        if name in incoming or not (live.exists() or live.is_symlink()):
            continue
        if not regular_file(live) or live.read_bytes() != deployed[name]:
            raise Refused('local-edit', name)
        removes.append(name)
    return writes, removes, adopted


def chezmoi_executable() -> str:
    configured = os.environ.get('CHEZMOI_EXECUTABLE')
    if configured:
        if os.path.isfile(configured) and os.access(configured, os.X_OK):
            return configured
        raise Refused('chezmoi-unavailable')
    found = shutil.which('chezmoi')
    if not found:
        raise Refused('chezmoi-unavailable')
    return found


def chezmoi_command(executable: str) -> list[str]:
    """Reuse the invocation context chezmoi gives its run scripts, else its default discovery."""
    command = [executable]
    source, config = os.environ.get('CHEZMOI_SOURCE_DIR'), os.environ.get('CHEZMOI_CONFIG_FILE')
    if source and config:
        command += ['--source', source, '--config', config]
        if not config.endswith(CONFIG_FORMATS):
            command += ['--config-format', 'toml']
    return command


def assert_public_leaves_stay_out(executable: str, match_dir: Path) -> None:
    managed = subprocess.run(
        chezmoi_command(executable) + ['managed', '--include=files,symlinks,scripts'],
        capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=CHEZMOI_TIMEOUT,
    )
    if managed.returncode != 0:
        raise Refused('chezmoi-unavailable')
    destination = os.environ.get('CHEZMOI_DEST_DIR') or str(Path.home())
    for entry in managed.stdout.splitlines():
        leaf = os.path.normpath(os.path.join(destination, entry))
        if leaf == str(match_dir) or leaf.startswith(str(match_dir) + os.sep):
            raise Refused('public-overlap')


def parses_as_mapping(executable: str, state_dir: Path, content: bytes) -> bool:
    handle, temporary = tempfile.mkstemp(dir=state_dir, prefix='.validate-')
    try:
        with os.fdopen(handle, 'wb') as stream:
            stream.write(content)
        probe = subprocess.run(
            [executable, '--config', '/dev/null', '--config-format', 'toml', 'execute-template',
             YAML_PROBE % json.dumps(temporary, ensure_ascii=False)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
            timeout=CHEZMOI_TIMEOUT,
        )
    finally:
        os.unlink(temporary)
    return probe.returncode == 0


def stage(match_dir: Path, content: bytes) -> Path:
    # Same-directory temporary file: the rename is atomic and espanso ignores non-YAML names.
    handle, temporary = tempfile.mkstemp(dir=match_dir, prefix='.espanso-match-sync-', suffix='.tmp')
    with os.fdopen(handle, 'wb') as stream:
        stream.write(content)
        stream.flush()
        os.fsync(stream.fileno())
    return Path(temporary)


def keep_preimages(state_dir: Path, match_dir: Path, names: list[str]) -> Path:
    preimages = state_dir / 'preimages'
    preimages.mkdir(mode=0o700, exist_ok=True)
    folder = preimages / datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')
    folder.mkdir(mode=0o700)
    for name in names:
        copy = folder / name
        copy.write_bytes((match_dir / name).read_bytes())
        copy.chmod(0o600)
    return folder


def apply_plan(match_dir: Path, writes: dict[str, bytes], removes: list[str],
               state_dir: Path) -> None:
    """Replace planned leaves; restore every preimage if a step fails after the first change."""
    staged: dict[str, Path] = {}
    preimages: Path | None = None
    changed: list[str] = []
    try:
        for name, content in writes.items():
            staged[name] = stage(match_dir, content)
        replaced = [name for name in writes if regular_file(match_dir / name)]
        if replaced or removes:
            preimages = keep_preimages(state_dir, match_dir, removes + replaced)
        for name, path in staged.items():
            os.replace(path, match_dir / name)
            changed.append(name)
        for name in removes:
            (match_dir / name).unlink()
            changed.append(name)
    except OSError:
        for path in staged.values():
            with contextlib.suppress(OSError):
                path.unlink(missing_ok=True)
        for name in reversed(changed):
            copy = preimages / name if preimages else None
            with contextlib.suppress(OSError):
                if copy and copy.exists():
                    shutil.copyfile(copy, match_dir / name)
                else:
                    (match_dir / name).unlink(missing_ok=True)
        raise Refused('write-failed') from None


def record(state_dir: Path, revision: str, leaves: list[str]) -> None:
    handle, temporary = tempfile.mkstemp(dir=state_dir, prefix='.state-')
    with os.fdopen(handle, 'w') as stream:
        stream.write(json.dumps({'revision': revision, 'leaves': sorted(leaves)}) + '\n')
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, state_dir / 'state.json')


def sync(checkout: Path, origin: str, config_root: Path, state_dir: Path) -> str:
    executable = chezmoi_executable()
    match_dir = config_root / 'match'
    validate_checkout(checkout, origin)
    if match_dir.is_symlink() or (match_dir.exists() and not match_dir.is_dir()):
        raise Refused('non-regular-live-file', 'match')
    assert_public_leaves_stay_out(executable, match_dir)
    fast_forward(checkout)
    revision = text_of(git(checkout, 'rev-parse', 'HEAD'))
    incoming = incoming_leaves(checkout, revision)
    if match_dir.exists():
        writes, removes, adopted = build_plan(match_dir, incoming, deployed_leaves(checkout, state_dir))
    else:
        writes, removes, adopted = dict(incoming), [], []
    if not writes and not removes:
        record(state_dir, revision, list(incoming))
        return f'espanso matches: added=0 updated=0 removed=0 unchanged={len(incoming)}'

    # Parse changed and newly adopted leaves before anything live is replaced.
    for name, content in [(n, writes[n]) for n in writes] + [(n, (match_dir / n).read_bytes())
                                                            for n in adopted]:
        if not parses_as_mapping(executable, state_dir, content):
            raise Refused('invalid-yaml', name)
    added = [name for name in writes if not regular_file(match_dir / name)]
    match_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    apply_plan(match_dir, writes, removes, state_dir)
    record(state_dir, revision, list(incoming))
    return (f'espanso matches: added={len(added)} updated={len(writes) - len(added)} '
            f'removed={len(removes)} unchanged={len(incoming) - len(writes)}')


def default_config_root() -> Path:
    home = Path.home()
    if sys.platform == 'darwin':
        return home / 'Library' / 'Application Support' / 'espanso'
    return Path(os.environ.get('XDG_CONFIG_HOME') or home / '.config') / 'espanso'


def default_state_dir() -> Path:
    home = Path.home()
    return Path(os.environ.get('XDG_STATE_HOME') or home / '.local' / 'state') / 'espanso-match-sync'


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--checkout', required=True, type=Path)
    parser.add_argument('--origin', required=True)
    parser.add_argument('--config-root', type=Path, help='Espanso config root (default: platform path)')
    parser.add_argument('--state-dir', type=Path, help='default: ~/.local/state/espanso-match-sync')
    args = parser.parse_args(argv)
    try:
        state_dir = args.state_dir or default_state_dir()
        state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.umask(0o077)
        with os.fdopen(os.open(state_dir / 'lock', os.O_CREAT | os.O_RDWR, 0o600), 'a') as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise Refused('busy') from None
            summary = sync(Path(args.checkout), args.origin,
                           args.config_root or default_config_root(), state_dir)
    except Refused as refused:
        leaves = f" leaves={','.join(refused.leaves)}" if refused.leaves else ''
        print(f'espanso-match-sync: incomplete reason={refused.reason}{leaves}; '
              'live matches unchanged', file=sys.stderr)
        return 1
    except (OSError, ValueError, subprocess.SubprocessError):
        print('espanso-match-sync: incomplete reason=failed', file=sys.stderr)
        return 1
    print(summary)
    return 0


if __name__ == '__main__':
    sys.exit(main())
