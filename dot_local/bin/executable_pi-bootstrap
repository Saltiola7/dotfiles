#!/usr/bin/env python3
"""Prepare one private Pi 400 image through existing Lima. Flash only through an explicit, current disk-bound plan."""
from __future__ import annotations
import argparse
import errno
import plistlib
import stat
import time
import base64
import getpass
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import urllib.request

PIN = 'aebf1cb693fbdbd45837980b3be6becbd34c321ff937c49e582244eaa2f48aaf'
SIGNER = '36F612DCF27F7D1A48A835E4DBFCF71C6D9F90A6'
FILENAME = 'Fedora-Minimal-44-1.7.aarch64.raw.xz'
CHECKSUM_URL = 'https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Spins/aarch64/images/Fedora-Spins-44-1.7-aarch64-CHECKSUM'
KEY_URL = 'https://fedoraproject.org/fedora.pgp'


class Invalid(ValueError):
    pass


def require(ok: bool, reason: str) -> None:
    if not ok: raise Invalid(reason)


def digest(path: Path) -> str:
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def validate_manifest(value: dict) -> None:
    expected = dict(schema_version=1, target='pi400', board='rpi400',
                    backend='personal-sandbox', owner='tis', uid=1000,
                    network='ethernet-dhcp', sudo='password-required', filename=FILENAME,
                    sha256=PIN, checksum_url=CHECKSUM_URL, key_url=KEY_URL, signer=SIGNER)
    require(value == expected and type(value.get('schema_version')) is int and type(value.get('uid')) is int,
            'manifest differs from reviewed preparation policy')


def public_key(value: str) -> str:
    parts = value.strip().split()
    require('\n' not in value.strip() and len(parts) >= 2 and parts[0] == 'ssh-ed25519',
            'one ed25519 public key required; private keys are forbidden')
    try:
        wire = base64.b64decode(parts[1], validate=True)
        require(len(wire) == 51 and struct.unpack('>I', wire[:4])[0] == 11 and
                wire[4:15] == b'ssh-ed25519' and struct.unpack('>I', wire[15:19])[0] == 32,
                'invalid ed25519 public key')
    except (ValueError, struct.error) as error:
        raise Invalid('invalid public key encoding') from error
    return parts[0] + ' ' + parts[1] + '\n'


def command(args: list[str], stdin: str | None = None) -> str:
    result = subprocess.run(args, input=stdin, capture_output=True, text=True)
    require(result.returncode == 0, 'operation failed; no secret output is displayed')
    return result.stdout


def backend_probe() -> dict:
    script = "import json,platform,shutil; from pathlib import Path; print(json.dumps(dict(arch=platform.machine(),fedora='ID=fedora' in Path('/etc/os-release').read_text(),tools=all(shutil.which(t) for t in ['debugfs','e2fsck','sfdisk','openssl','ssh-keygen','python3','visudo']))))"
    result = json.loads(command(['limactl', 'shell', '--workdir', '/', 'personal-sandbox', '--', 'python3', '-c', script]))
    require(result == dict(arch='aarch64', fedora=True, tools=True), 'Lima identity or capabilities mismatch')
    return result


def verify_output(output: Path) -> dict:
    receipt = json.loads((output / 'receipt.json').read_text())
    require(type(receipt.get('schema_version')) is int and receipt.get('schema_version') == 1 and receipt.get('target') == 'pi400' and receipt.get('base_sha256') == PIN, 'invalid preparation receipt')
    require(re.fullmatch(r'[0-9a-f]{64}', receipt.get('prepared_sha256', '')) is not None, 'invalid prepared identity')
    require(digest(output / 'prepared.raw') == receipt['prepared_sha256'], 'prepared image hash mismatch')
    return receipt


def provenance(manifest: dict, stage: Path) -> None:
    for url, name in [(manifest['key_url'], 'fedora.pgp'), (manifest['checksum_url'], 'CHECKSUM')]:
        with urllib.request.urlopen(url, timeout=60) as response:
            data = response.read(1024 * 1024 + 1)
        require(len(data) <= 1024 * 1024, 'publisher metadata exceeds limit')
        (stage / name).write_bytes(data)
    home = stage / 'gnupg'; home.mkdir(mode=0o700)
    command(['gpg', '--homedir', str(home), '--batch', '--import', str(stage / 'fedora.pgp')])
    status = command(['gpg', '--homedir', str(home), '--batch', '--status-fd', '1', '--verify', str(stage / 'CHECKSUM')])
    require(any(line.startswith('[GNUPG:] VALIDSIG ' + SIGNER + ' ') for line in status.splitlines()), 'publisher signature mismatch')
    require(f'SHA256 ({FILENAME}) = {PIN}' in (stage / 'CHECKSUM').read_text(), 'signed checksum mismatch')


def inputs(args: argparse.Namespace, manifest: dict) -> str:
    require(args.image.is_file() and args.image.name == manifest['filename'], 'reviewed compressed image required')
    require(digest(args.image) == manifest['sha256'], 'base image hash mismatch')
    require(args.key.is_file() and args.key.stat().st_size <= 16384, 'bounded public-key file required')
    key = public_key(args.key.read_text())
    backend_probe()
    homelab = shutil.which('homelab') or str(Path.home() / '.local/bin/homelab')
    target = json.loads(command([homelab, 'inspect', 'pi400']))['target']
    require(target['kind'] == 'physical' and target['architecture'] == 'arm64', 'declared Pi target mismatch')
    return key


def prepare(args: argparse.Namespace, manifest: dict) -> dict:
    require(sys.stdin.isatty(), 'prepare requires an operator terminal for private password entry')
    require(not args.output.exists(), 'output directory already exists; choose a new directory')
    key = inputs(args, manifest)
    args.output.mkdir(mode=0o700, parents=True)
    stage = args.output / 'provenance'; stage.mkdir(mode=0o700)
    provenance(manifest, stage)
    password = getpass.getpass('New Pi tis password (for sudo; SSH stays key-only): ')
    require(len(password) >= 12 and '\n' not in password, 'password requires at least 12 characters and no newline')
    require(password == getpass.getpass('Confirm Pi password: '), 'passwords do not match')
    remote = command(['limactl', 'shell', '--workdir', '/', 'personal-sandbox', '--', 'sh', '-c',
        'umask 077; mkdir -p "$HOME/.local/state/pi-bootstrap"; mktemp -d "$HOME/.local/state/pi-bootstrap/run-XXXXXXXX"']).strip()
    require(re.fullmatch(r'/home/tis\.guest/\.local/state/pi-bootstrap/run-[A-Za-z0-9]+', remote) is not None, 'unexpected backend staging path')
    (stage / 'authorized_keys').write_text(key)
    (stage / 'manifest.json').write_text(json.dumps(manifest))
    files = [(args.image, FILENAME), (stage / 'authorized_keys', 'authorized_keys'),
             (stage / 'manifest.json', 'manifest.json')]
    for name in ('prepare.sh', 'prepare.py', 'first-boot.sh'):
        files.append((args.backend_dir / name, name))
    for path, name in files:
        require(path.is_file(), 'maintained backend artifact missing')
        command(['limactl', 'copy', str(path), f'personal-sandbox:{remote}/{name}'])
    (args.output / 'backend-stage.txt').write_text(remote + '\n')
    print('Preparing private image in isolated Lima staging; no disk writes.', flush=True)
    # Password exists only in process memory and encrypted SSH stdin.
    command(['limactl', 'shell', '--workdir', '/', 'personal-sandbox', '--', 'sh', remote + '/prepare.sh', remote],
            stdin=json.dumps(dict(password=password)))
    password = ''
    for name in ('prepared.raw', 'receipt.json'):
        command(['limactl', 'copy', f'personal-sandbox:{remote}/{name}', str(args.output / name)])
        (args.output / name).chmod(0o600)
    receipt = verify_output(args.output)
    print('Prepared image verified. Physical boot remains unverified. Retain private staging until successful boot.')
    return receipt


# Physical operations are explicit and require an operator-owned private plan.
DISK_FIELDS = ('DeviceIdentifier', 'DeviceNode', 'WholeDisk', 'Internal', 'Writable',
               'BusProtocol', 'MediaName', 'TotalSize', 'DeviceTreePath')


def disk_identity(info: dict, node: str) -> dict:
    require(re.fullmatch(r'/dev/disk[0-9]+', node) is not None, 'external whole-disk node required')
    require(info.get('DeviceNode') == node and info.get('DeviceIdentifier') == node[5:], 'disk node identity mismatch')
    require(info.get('WholeDisk') is True and info.get('Internal') is False and
            info.get('Writable') is True and info.get('BusProtocol') == 'USB', 'writable external USB whole disk required')
    require(info.get('MediaName') == 'Transcend' and type(info.get('TotalSize')) is int and
            info['TotalSize'] == 512110190592, 'disk differs from approved StoreJet media and capacity')
    require(isinstance(info.get('DeviceTreePath'), str) and bool(info['DeviceTreePath']), 'USB attachment identity unavailable')
    return {key: info[key] for key in DISK_FIELDS}


def disk_info(node: str) -> dict:
    require(re.fullmatch(r'/dev/disk[0-9]+', node) is not None, 'invalid disk node')
    value = plistlib.loads(command(['/usr/sbin/diskutil', 'info', '-plist', node]).encode())
    return disk_identity(value, node)


def plan_digest(value: dict) -> str:
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':')).encode()).hexdigest()


def validate_flash_plan(value: dict, approval: str) -> None:
    require(set(value) == {'schema_version', 'target', 'image', 'image_size', 'image_sha256',
            'disk', 'header_sha256', 'created_at', 'expires_at'}, 'invalid flash plan schema')
    require(type(value['schema_version']) is int and value['schema_version'] == 1 and value['target'] == 'pi400', 'invalid flash target')
    require(type(value['created_at']) is int and type(value['expires_at']) is int and
            value['created_at'] <= time.time() < value['expires_at'] and
            0 < value['expires_at'] - value['created_at'] <= 1800, 'flash plan expired or invalid')
    require(type(value['image_size']) is int and 0 < value['image_size'] <= value['disk']['TotalSize'] and
            value['image_size'] % 512 == 0, 'invalid image byte count')
    require(isinstance(value['image'], str) and Path(value['image']).is_absolute(), 'absolute private image path required')
    for key in ('image_sha256', 'header_sha256'):
        require(isinstance(value[key], str) and re.fullmatch(r'[0-9a-f]{64}', value[key]) is not None, 'invalid plan hash')
    require(value['disk'] == disk_identity(value['disk'], value['disk']['DeviceNode']), 'invalid disk identity')
    require(approval == plan_digest(value), 'approval does not match immutable flash plan')


def raw_node(node: str) -> str:
    require(re.fullmatch(r'/dev/disk[0-9]+', node) is not None, 'invalid whole-disk node')
    return '/dev/r' + node[5:]


def header_digest(node: str) -> str:
    raw = raw_node(node)
    require(stat.S_ISCHR(os.stat(raw).st_mode), 'raw device must be a character device')
    with open(raw, 'rb', buffering=0) as source:
        data = source.read(1024 * 1024)
    require(len(data) == 1024 * 1024, 'unable to read disk identity header')
    return hashlib.sha256(data).hexdigest()


def operator_uid() -> int:
    require(os.geteuid() == 0 and sys.stdin.isatty(), 'run this operation with sudo in your own terminal')
    require(os.environ.get('SUDO_UID', '').isdigit(), 'sudo operator identity required')
    uid = int(os.environ['SUDO_UID']); require(uid > 0, 'non-root operator required')
    return uid


def private_file(path: Path, uid: int) -> None:
    require(not path.is_symlink() and path.is_file() and path.stat().st_uid == uid and
            path.stat().st_mode & 0o077 == 0, 'operator-owned private regular file required')
    parent = path.parent
    require(not parent.is_symlink() and parent.stat().st_uid == uid and
            parent.stat().st_mode & 0o077 == 0, 'operator-owned private directory required')


def private_json(path: Path, value: dict, uid: int) -> None:
    require(not path.exists() and not path.is_symlink(), 'private output already exists')
    require(path.parent.stat().st_uid == uid and path.parent.stat().st_mode & 0o077 == 0, 'unsafe private output parent')
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'w') as stream:
        json.dump(value, stream, indent=2); stream.write('\n'); stream.flush(); os.fsync(stream.fileno())
        os.fchown(stream.fileno(), uid, int(os.environ['SUDO_GID']))


def flash_plan(args: argparse.Namespace) -> None:
    uid = operator_uid()
    output = args.output.resolve(); image = output / 'prepared.raw'
    private_file(image, uid); private_file(output / 'receipt.json', uid)
    receipt = verify_output(output)
    required = {'publisher-verified-input', 'offline-filesystem', 'account-uid-gid', 'key-owner-mode',
                'key-only-ssh', 'password-required-sudo', 'SELinux-enforcing-relabel',
                'initial-setup-masked', 'first-boot-growth-installed'}
    require(required <= set(receipt.get('checks', [])), 'preparation verification checks incomplete')
    require(image.stat().st_size == 5596250112, 'unexpected prepared image size')
    identity = disk_info(args.disk)
    now = int(time.time())
    value = dict(schema_version=1, target='pi400', image=str(image), image_size=image.stat().st_size,
                 image_sha256=receipt['prepared_sha256'], disk=identity,
                 header_sha256=header_digest(args.disk), created_at=now, expires_at=now+1800)
    require(args.plan.resolve().parent == output, 'plan must stay in private prepared directory')
    private_json(args.plan, value, uid)
    print(json.dumps(value, indent=2)); print('Approval digest: ' + plan_digest(value))
    print('Read-only plan created; no disk was unmounted or written. Valid for 30 minutes.')


def flush_device(device) -> None:
    device.flush()
    try:
        os.fsync(device.fileno())
    except OSError as error:
        if error.errno not in (errno.EINVAL, errno.ENOTSUP): raise
        # Some character devices do not implement fsync; sync is the OS fallback.
        command(['/bin/sync'])


def write_and_verify(source, device, size: int, expected: str, flush=flush_device) -> str:
    require(type(size) is int and size > 0 and size % 512 == 0, 'invalid write byte count')
    source.seek(0, os.SEEK_END)
    require(source.tell() == size, 'image size changed before disk write')
    source.seek(0)
    require(hashlib.file_digest(source, 'sha256').hexdigest() == expected, 'image changed before disk write')
    source.seek(0); device.seek(0); remaining = size; written = hashlib.sha256()
    while remaining:
        data = source.read(min(4 * 1024 * 1024, remaining))
        require(bool(data), 'image truncated during disk write')
        written.update(data); view = memoryview(data)
        while view:
            count = device.write(view)
            require(isinstance(count, int) and 0 < count <= len(view), 'incomplete disk write')
            view = view[count:]
        remaining -= len(data)
    require(not source.read(1) and written.hexdigest() == expected, 'image changed during disk write')
    flush(device); device.seek(0); remaining = size; verified = hashlib.sha256()
    while remaining:
        data = device.read(min(4 * 1024 * 1024, remaining))
        require(bool(data), 'disk readback truncated')
        verified.update(data); remaining -= len(data)
    require(verified.hexdigest() == expected, 'disk readback hash mismatch; do not boot this disk')
    return verified.hexdigest()


def flash(args: argparse.Namespace) -> None:
    uid = operator_uid(); private_file(args.plan, uid)
    require(args.plan.stat().st_size <= 65536, 'flash plan too large')
    value = json.loads(args.plan.read_text()); validate_flash_plan(value, args.approve_plan)
    image = Path(value['image']); private_file(image, uid)
    require(image.parent == args.plan.resolve().parent, 'plan/image directory mismatch')
    receipt = verify_output(image.parent)
    require(image.stat().st_size == value['image_size'] and receipt['prepared_sha256'] == value['image_sha256'], 'prepared identity changed')
    node = value['disk']['DeviceNode']
    require(disk_info(node) == value['disk'] and header_digest(node) == value['header_sha256'], 'disk identity changed; create new plan')
    destination = args.plan.parent / 'flash-receipt.json'
    require(not destination.exists(), 'flash receipt exists; review before another operation')
    command(['/usr/sbin/diskutil', 'unmountDisk', node])
    require(disk_info(node) == value['disk'] and header_digest(node) == value['header_sha256'], 'disk identity changed after unmount')
    raw = raw_node(node); require(stat.S_ISCHR(os.stat(raw).st_mode), 'raw device type changed')
    print('Writing approved StoreJet and verifying full image readback; do not unplug.', flush=True)
    with image.open('rb') as source, open(raw, 'r+b', buffering=0) as device:
        require(disk_info(node) == value['disk'], 'disk identity changed before write')
        verified = write_and_verify(source, device, value['image_size'], value['image_sha256'])
    require(disk_info(node) == value['disk'], 'disk identity changed after verification')
    private_json(destination, dict(schema_version=1, target='pi400', plan_digest=args.approve_plan,
                 image_sha256=verified, byte_count=value['image_size'], readback='passed',
                 physical_boot='unverified', completed_at=int(time.time())), uid)
    command(['/usr/sbin/diskutil', 'eject', node])
    print('StoreJet full readback verified and ejected. Connect SSD + Ethernet to Pi 400, then power on.')


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--manifest', type=Path, default=Path.home() / '.config/pi-bootstrap/manifest.json')
    parser.add_argument('--backend-dir', type=Path, default=Path.home() / '.local/lib/pi-bootstrap')
    subs = parser.add_subparsers(dest='operation', required=True)
    for name in ('plan', 'prepare'):
        sub = subs.add_parser(name)
        sub.add_argument('--image', type=Path, required=True)
        sub.add_argument('--key', type=Path, required=True)
        if name == 'prepare': sub.add_argument('--output', type=Path, required=True)
    verify = subs.add_parser('verify'); verify.add_argument('--output', type=Path, required=True)
    planned = subs.add_parser('flash-plan')
    planned.add_argument('--output', type=Path, required=True)
    planned.add_argument('--disk', required=True)
    planned.add_argument('--plan', type=Path, required=True)
    writer = subs.add_parser('flash')
    writer.add_argument('--plan', type=Path, required=True)
    writer.add_argument('--approve-plan', required=True)
    args = parser.parse_args()
    try:
        manifest = json.loads(args.manifest.read_text()); validate_manifest(manifest)
        if args.operation == 'flash-plan':
            flash_plan(args)
        elif args.operation == 'flash':
            flash(args)
        elif args.operation == 'verify':
            receipt = verify_output(args.output)
            print(json.dumps(receipt, sort_keys=True, indent=2))
        elif args.operation == 'plan':
            inputs(args, manifest)
            print(json.dumps(dict(target=manifest['target'], backend=manifest['backend'],
                  base_sha256=manifest['sha256'], sudo=manifest['sudo'], disk_writes=False,
                  password_entry='private operator terminal', physical_boot='unverified'), indent=2))
        else:
            prepare(args, manifest)
        return 0
    except Invalid as error:
        print(f'pi-bootstrap: {error}', file=sys.stderr)
    except (OSError, ValueError, EOFError, KeyError, TypeError):
        print('pi-bootstrap: operation unavailable or input invalid; private staging retained', file=sys.stderr)
    return 2


if __name__ == '__main__':
    raise SystemExit(main())
