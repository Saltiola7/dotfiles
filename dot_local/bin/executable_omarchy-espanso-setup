#!/usr/bin/env bash
# Installs the x86_64 Omarchy Espanso package and verifies its input capability.
# Chezmoi owns config/, the graphical service and enablement once espanso_enabled
# is set; private Git owns match/. This helper never adds files to any source.
set -euo pipefail
if [[ $(uname -m) != x86_64 ]]; then
  echo 'No reviewed Espanso package for this architecture yet.' >&2
  exit 1
fi
if ! pacman -Q espanso-wayland-bin >/dev/null 2>&1; then
  [[ -t 0 ]] || { echo 'Run in Kitty for package installation prompts.' >&2; exit 1; }
  omarchy pkg aur add espanso-wayland-bin
fi
espanso --version
# Espanso's unprivileged Wayland model: the packaged binary carries the capability
# to read input devices. Never run the daemon as root instead. libcap prints the
# permitted bit as "=p"; older releases spelled it "+p".
getcap /usr/bin/espanso | grep -Eq 'cap_dac_override[+=]e?p([^a-z_]|$)' || {
  echo 'Missing cap_dac_override+p on /usr/bin/espanso; reinstall espanso-wayland-bin.' >&2
  exit 1
}
echo 'Espanso is installed. Chezmoi applies config/ and startup after espanso_enabled = true.'
echo 'Personal matches come only from an enrolled private Git checkout.'
