#!/bin/bash
# secret — Load secrets from 1Password into the current shell session.
#
# This script is designed to be SOURCED, not executed:
#   . secret        (from interactive shell or agent session)
#   source secret   (equivalent)
#
# In interactive shells, just type 'secret' — the shell function wrapper
# defined in .common_profile will source this automatically.

# --- Guard: prevent execution as subprocess ---
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  echo "This script must be sourced, not executed."
  echo "Usage: . secret  OR  source secret"
  exit 1
fi

# --- Idempotency: skip if already loaded ---
if [ -n "$_SECRETS_LOADED" ]; then
  echo "Secrets already loaded."
  return 0
fi

# --- Helper: read from 1Password with validation ---
# Returns non-zero if op read fails or returns empty, preventing silent failures
# when 1Password can't authenticate (e.g., no Touch ID in agent sessions).
__op_read() {
  local val
  val="$(op read "$1" 2>/dev/null)"
  if [ -z "$val" ]; then
    echo "error: op read failed or returned empty for: $1" >&2
    return 1
  fi
  printf '%s' "$val"
}

# --- GCP credential cleanup helper ---
__cleanup_gcp_cache() {
  rm -f "$HOME/.cache/gcp/enterprise-seo-tools-sa.json" \
       "$HOME/.cache/gcp/gws-content-reader-key.json" 2>/dev/null
}

echo "Loading secrets from 1Password..."
export GEMINI_API_KEY="$(__op_read 'op://Personal/Gemini API Key/credential')" && \
[ -n "$GEMINI_API_KEY" ] && \
export GEMINI_DEEP_RESEARCH_API_KEY="$GEMINI_API_KEY" && \
export GOOGLE_GENERATIVE_AI_API_KEY="$(__op_read 'op://Personal/Google AI API Key/credential')" && \
[ -n "$GOOGLE_GENERATIVE_AI_API_KEY" ] && \
export OPENAI_API_KEY="$(__op_read 'op://Personal/OpenAI API Key/credential')" && \
[ -n "$OPENAI_API_KEY" ] && \
export AWS_PROFILE="$(__op_read 'op://Personal/AWS Bedrock/profile')" && \
[ -n "$AWS_PROFILE" ] && \
export AWS_REGION="$(__op_read 'op://Personal/AWS Bedrock/region')" && \
[ -n "$AWS_REGION" ] && \
export CLAUDE_CODE_USE_BEDROCK=1 && \
# --- GCP Service Account ---
mkdir -p "$HOME/.cache/gcp" && \
__op_read 'op://Personal/GCP Service Account - Enterprise SEO Tools/credential' >| "$HOME/.cache/gcp/enterprise-seo-tools-sa.json" && \
[ -s "$HOME/.cache/gcp/enterprise-seo-tools-sa.json" ] && \
chmod 600 "$HOME/.cache/gcp/enterprise-seo-tools-sa.json" && \
export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.cache/gcp/enterprise-seo-tools-sa.json" && \
export GOOGLE_VERTEX_PROJECT="$(__op_read 'op://Personal/GCP Service Account - Enterprise SEO Tools/project')" && \
[ -n "$GOOGLE_VERTEX_PROJECT" ] && \
export GOOGLE_VERTEX_LOCATION="$(__op_read 'op://Personal/GCP Service Account - Enterprise SEO Tools/location')" && \
[ -n "$GOOGLE_VERTEX_LOCATION" ] && \
export GOOGLE_CLOUD_PROJECT="$GOOGLE_VERTEX_PROJECT" && \
export GOOGLE_PROJECT="$GOOGLE_VERTEX_PROJECT" && \
# gcloud CLI auth — session-scoped, no credentials persisted to gcloud's store
export CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE="$HOME/.cache/gcp/enterprise-seo-tools-sa.json" && \
export CLOUDSDK_ACTIVE_CONFIG_NAME=sa-dev-admin && \
# --- SEO Data Science (MGM) ---
export CLICKHOUSE_HOST="$(__op_read 'op://Personal/ClickHouse MGM Cloud/host')" && \
[ -n "$CLICKHOUSE_HOST" ] && \
export CLICKHOUSE_USER="$(__op_read 'op://Personal/ClickHouse MGM Cloud/user')" && \
[ -n "$CLICKHOUSE_USER" ] && \
export CLICKHOUSE_PORT="$(__op_read 'op://Personal/ClickHouse MGM Cloud/port')" && \
[ -n "$CLICKHOUSE_PORT" ] && \
export CLICKHOUSE_PASSWORD="$(__op_read 'op://Personal/ClickHouse MGM Cloud/password')" && \
[ -n "$CLICKHOUSE_PASSWORD" ] && \
export SEMRUSH_API="$(__op_read 'op://Personal/SEMRUSH API/credential')" && \
[ -n "$SEMRUSH_API" ] && \
export SEMRUSH_ENTERPRISE_API="$(__op_read 'op://Personal/SEMRUSH API/enterprise')" && \
[ -n "$SEMRUSH_ENTERPRISE_API" ] && \
export PAGESPEED_API_KEY="$(__op_read 'op://Personal/PageSpeed API/credential')" && \
[ -n "$PAGESPEED_API_KEY" ] && \
export AI_STUDIO_KEY="$GOOGLE_GENERATIVE_AI_API_KEY" && \
export GCS_AKAMAI_ACCESS_KEY="$(__op_read 'op://Personal/Akamai GCS HMAC/access_key')" && \
[ -n "$GCS_AKAMAI_ACCESS_KEY" ] && \
export GCS_AKAMAI_SECRET_KEY="$(__op_read 'op://Personal/Akamai GCS HMAC/secret_key')" && \
[ -n "$GCS_AKAMAI_SECRET_KEY" ] && \
export GITHUB_PERSONAL_ACCESS_TOKEN_CLASSIC="$(__op_read 'op://Personal/GitHub PAT Classic/credential')" && \
[ -n "$GITHUB_PERSONAL_ACCESS_TOKEN_CLASSIC" ] && \
export ATLASSIAN_API="$(__op_read 'op://Personal/Atlassian API Token/credential')" && \
[ -n "$ATLASSIAN_API" ] && \
export ROVODEV="$ATLASSIAN_API" && \
export EMAIL="$(__op_read 'op://Personal/Atlassian API Token/email')" && \
[ -n "$EMAIL" ] && \
export ATLASSIAN_URL="$(__op_read 'op://Personal/Atlassian API Token/url')" && \
[ -n "$ATLASSIAN_URL" ] && \
# --- GWS Content Reader SA (materialized for file-path consumers) ---
__op_read 'op://Personal/GCP Service Account - GWS Content Reader/credential' >| "$HOME/.cache/gcp/gws-content-reader-key.json" && \
[ -s "$HOME/.cache/gcp/gws-content-reader-key.json" ] && \
chmod 600 "$HOME/.cache/gcp/gws-content-reader-key.json" && \
export GWS_CONTENT_READER_CREDENTIALS="$HOME/.cache/gcp/gws-content-reader-key.json" && \
trap '__cleanup_gcp_cache' EXIT && \
_SECRETS_LOADED=1 && \
echo "Secrets loaded." || {
  echo "Failed to load secrets — is 1Password unlocked?" >&2
  # Clean up any partial state so retry is possible
  unset _SECRETS_LOADED
  __cleanup_gcp_cache
  return 1
}
