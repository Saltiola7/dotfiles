#!/bin/bash
# secret — Load secrets from 1Password into the current shell session.
#
# This script is designed to be SOURCED, not executed:
#   . secret        (from interactive shell or agent session)
#   source secret   (equivalent)
#
# In interactive shells, just type 'secret' — the shell function wrapper
# defined in .common_profile will source this automatically.

# --- Guard: prevent execution as subprocess ---
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  echo "This script must be sourced, not executed."
  echo "Usage: . secret  OR  source secret"
  exit 1
fi

# --- Idempotency: skip if already loaded ---
if [ -n "$_SECRETS_LOADED" ]; then
  echo "Secrets already loaded."
  return 0
fi

# --- Local dependencies needed before prompting for 1Password auth ---
if ! command -v jq >/dev/null 2>&1; then
  echo "error: jq is required for batched secret loading." >&2
  return 1
fi

# --- Ensure a usable 1Password session (shared, cached, one Touch ID per restart) ---
# Sourcing op-session resolves a valid OP_SESSION token from: current env, the
# on-disk cache (~/.cache/op/session), or a fresh biometric mint (TTY only).
# Non-TTY agent shells inherit the token a TTY pane already cached.
if command -v op-session >/dev/null 2>&1; then
  . op-session || {
    echo "Failed to acquire 1Password session — run 'secret' once in an interactive herdr pane." >&2
    return 1
  }
fi

# --- Helpers: bounded commands, profiling, and batched 1Password extraction ---
__OP_TIMEOUT_SECONDS="${OP_TIMEOUT_SECONDS:-8}"

__run_with_timeout() {
  perl -e '
    use strict;
    use warnings;
    my $timeout = shift @ARGV;
    my $pid = fork();
    die "fork failed\n" unless defined $pid;
    if ($pid == 0) {
      exec @ARGV;
      exit 127;
    }
    local $SIG{ALRM} = sub {
      kill "TERM", $pid;
      select undef, undef, undef, 0.2;
      kill "KILL", $pid;
      exit 124;
    };
    alarm $timeout;
    waitpid($pid, 0);
    my $status = $?;
    exit 127 if $status == -1;
    exit(128 + ($status & 127)) if $status & 127;
    exit($status >> 8);
  ' "$__OP_TIMEOUT_SECONDS" "$@"
}

__profile_now_ms() {
  perl -MTime::HiRes=time -e 'printf "%.0f", time() * 1000'
}

__profile_log() {
  [ -n "${SECRET_PROFILE:-}" ] || return 0
  printf 'secret profile: %s\n' "$*" >&2
}

__profile_elapsed() {
  [ -n "${SECRET_PROFILE:-}" ] || return 0
  local start end label
  start="$1"
  label="$2"
  end="$(__profile_now_ms)"
  __profile_log "$label: $((end - start))ms"
}

__fetch_secret_bundle() {
  local start tmpdir pids pid rc count
  start="$(__profile_now_ms)"
  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/secret-op.XXXXXX")" || return 1
  chmod 700 "$tmpdir" 2>/dev/null || true
  pids=""

  __fetch_one_secret_item() {
    local idx item
    idx="$1"
    item="$2"
    __run_with_timeout op item get "$item" --reveal --format json >| "$tmpdir/$idx.json" 2>| "$tmpdir/$idx.err"
  }

  __fetch_one_secret_item 01 'Gemini API Key' & pids="$pids $!"
  __fetch_one_secret_item 02 'Google AI API Key' & pids="$pids $!"
  __fetch_one_secret_item 03 'OpenAI API Key' & pids="$pids $!"
  __fetch_one_secret_item 04 'Databricks' & pids="$pids $!"
  __fetch_one_secret_item 05 'AWS Bedrock' & pids="$pids $!"
  __fetch_one_secret_item 06 'GCP Service Account - Enterprise SEO Tools' & pids="$pids $!"
  __fetch_one_secret_item 07 'ClickHouse MGM Cloud' & pids="$pids $!"
  __fetch_one_secret_item 08 'SEMRUSH API' & pids="$pids $!"
  __fetch_one_secret_item 09 'PageSpeed API' & pids="$pids $!"
  __fetch_one_secret_item 10 'Akamai GCS HMAC' & pids="$pids $!"
  __fetch_one_secret_item 11 'Clockify API Key' & pids="$pids $!"
  __fetch_one_secret_item 12 'GitHub PAT Classic' & pids="$pids $!"
  __fetch_one_secret_item 13 'Atlassian API Token' & pids="$pids $!"
  __fetch_one_secret_item 14 'GCP Service Account - GWS Content Reader' & pids="$pids $!"

  rc=0
  for pid in $pids; do
    wait "$pid" || rc=1
  done

  if [ "$rc" -ne 0 ]; then
    echo "error: parallel 1Password item fetch failed or timed out." >&2
    rm -rf "$tmpdir"
    return 1
  fi

  __SECRET_ITEMS_JSON="$(jq -c -s '.' "$tmpdir"/*.json)" || {
    echo "error: failed to parse 1Password item JSON." >&2
    rm -rf "$tmpdir"
    return 1
  }

  rm -rf "$tmpdir"

  count="$(printf '%s' "$__SECRET_ITEMS_JSON" | jq 'length')" || return 1
  if [ "$count" -lt 14 ]; then
    echo "error: 1Password item fetch returned $count items, expected at least 14." >&2
    return 1
  fi

  __profile_elapsed "$start" "1Password parallel fetch"
}

__secret_field() {
  local item field val
  item="$1"
  field="$2"
  val="$(printf '%s' "$__SECRET_ITEMS_JSON" | jq -er --arg item "$item" --arg field "$field" '
    (map(select(.title == $item)) | first | .fields // [] |
      map(select(.label == $field)) | first | .value) // empty
  ')" || return 1
  [ -n "$val" ] || return 1
  printf '%s' "$val"
}

__secret_required() {
  local name item field val
  name="$1"
  item="$2"
  field="$3"
  val="$(__secret_field "$item" "$field")" || {
    echo "error: missing required secret field: $item/$field ($name)" >&2
    return 1
  }
  printf '%s' "$val"
}

__export_secret_required() {
  local name val
  name="$1"
  shift
  val="$(__secret_required "$name" "$@")" || return 1
  export "$name=$val"
}

__unset_secret_env() {
  unset GEMINI_API_KEY \
        GEMINI_DEEP_RESEARCH_API_KEY \
        GOOGLE_GENERATIVE_AI_API_KEY \
        OPENAI_API_KEY \
        DATABRICKS_HOST \
        DATABRICKS_TOKEN \
        AWS_PROFILE \
        AWS_REGION \
        CLAUDE_CODE_USE_BEDROCK \
        GOOGLE_APPLICATION_CREDENTIALS \
        GOOGLE_VERTEX_PROJECT \
        GOOGLE_VERTEX_LOCATION \
        GOOGLE_CLOUD_PROJECT \
        GOOGLE_PROJECT \
        CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE \
        CLOUDSDK_ACTIVE_CONFIG_NAME \
        CLICKHOUSE_HOST \
        CLICKHOUSE_USER \
        CLICKHOUSE_PORT \
        CLICKHOUSE_PASSWORD \
        SEMRUSH_API \
        SEMRUSH_ENTERPRISE_API \
        PAGESPEED_API_KEY \
        AI_STUDIO_KEY \
        GCS_AKAMAI_ACCESS_KEY \
        GCS_AKAMAI_SECRET_KEY \
        CLOCKIFY_API_KEY \
        GITHUB_PERSONAL_ACCESS_TOKEN_CLASSIC \
        ATLASSIAN_API \
        ROVODEV \
        EMAIL \
        ATLASSIAN_URL \
        GWS_CONTENT_READER_CREDENTIALS
}

# --- GCP credential cleanup helper ---
# Mirrors .common_profile's cleanup: remove ephemeral SA files AND clear the
# env vars that point at them. CLOUDSDK_ACTIVE_CONFIG_NAME / CLOUDSDK_CORE_ACCOUNT
# must be cleared too — a surviving config pin with a deleted key file wedges
# every gcloud call ("Failed to load credential file" / non-interactive Reauth).
__cleanup_gcp_cache() {
  # Under herdr, sibling panes share these cache files. Exiting one pane must not
  # yank the SA file out from under still-open panes — let the herdr session
  # lifecycle own cleanup. Outside herdr, clean up normally.
  [ -n "$HERDR_ENV" ] && return 0
  rm -f "$HOME/.cache/gcp/enterprise-seo-tools-sa.json" \
       "$HOME/.cache/gcp/gws-content-reader-key.json" 2>/dev/null
  unset GOOGLE_APPLICATION_CREDENTIALS \
        GWS_CONTENT_READER_CREDENTIALS \
        CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE \
        CLOUDSDK_ACTIVE_CONFIG_NAME \
        CLOUDSDK_CORE_ACCOUNT
}

echo "Loading secrets from 1Password..."
__load_start="$(__profile_now_ms)"

if __fetch_secret_bundle && \
  __export_secret_required GEMINI_API_KEY 'Gemini API Key' credential && \
  export GEMINI_DEEP_RESEARCH_API_KEY="$GEMINI_API_KEY" && \
  __export_secret_required GOOGLE_GENERATIVE_AI_API_KEY 'Google AI API Key' credential && \
  __export_secret_required OPENAI_API_KEY 'OpenAI API Key' credential && \
  __export_secret_required DATABRICKS_HOST Databricks host && \
  __export_secret_required DATABRICKS_TOKEN Databricks credential && \
  __export_secret_required AWS_PROFILE 'AWS Bedrock' profile && \
  __export_secret_required AWS_REGION 'AWS Bedrock' region && \
  export CLAUDE_CODE_USE_BEDROCK=1 && \
  mkdir -p "$HOME/.cache/gcp" && \
  __secret_required GCP_ENTERPRISE_SEO_TOOLS_CREDENTIAL 'GCP Service Account - Enterprise SEO Tools' credential >| "$HOME/.cache/gcp/enterprise-seo-tools-sa.json" && \
  [ -s "$HOME/.cache/gcp/enterprise-seo-tools-sa.json" ] && \
  chmod 600 "$HOME/.cache/gcp/enterprise-seo-tools-sa.json" && \
  export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.cache/gcp/enterprise-seo-tools-sa.json" && \
  __export_secret_required GOOGLE_VERTEX_PROJECT 'GCP Service Account - Enterprise SEO Tools' project && \
  __export_secret_required GOOGLE_VERTEX_LOCATION 'GCP Service Account - Enterprise SEO Tools' location && \
  export GOOGLE_CLOUD_PROJECT="$GOOGLE_VERTEX_PROJECT" && \
  export GOOGLE_PROJECT="$GOOGLE_VERTEX_PROJECT" && \
  export CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE="$HOME/.cache/gcp/enterprise-seo-tools-sa.json" && \
  export CLOUDSDK_ACTIVE_CONFIG_NAME=sa-dev-admin && \
  __export_secret_required CLICKHOUSE_HOST 'ClickHouse MGM Cloud' host && \
  __export_secret_required CLICKHOUSE_USER 'ClickHouse MGM Cloud' user && \
  __export_secret_required CLICKHOUSE_PORT 'ClickHouse MGM Cloud' port && \
  __export_secret_required CLICKHOUSE_PASSWORD 'ClickHouse MGM Cloud' password && \
  __export_secret_required SEMRUSH_API 'SEMRUSH API' credential && \
  __export_secret_required SEMRUSH_ENTERPRISE_API 'SEMRUSH API' enterprise && \
  __export_secret_required PAGESPEED_API_KEY 'PageSpeed API' credential && \
  export AI_STUDIO_KEY="$GOOGLE_GENERATIVE_AI_API_KEY" && \
  __export_secret_required GCS_AKAMAI_ACCESS_KEY 'Akamai GCS HMAC' access_key && \
  __export_secret_required GCS_AKAMAI_SECRET_KEY 'Akamai GCS HMAC' secret_key && \
  __export_secret_required CLOCKIFY_API_KEY 'Clockify API Key' credential && \
  mkdir -p /tmp/sketchybar_clockify && \
  printf '%s' "$CLOCKIFY_API_KEY" >| /tmp/sketchybar_clockify/api_key && \
  chmod 600 /tmp/sketchybar_clockify/api_key && \
  __export_secret_required GITHUB_PERSONAL_ACCESS_TOKEN_CLASSIC 'GitHub PAT Classic' credential && \
  __export_secret_required ATLASSIAN_API 'Atlassian API Token' credential && \
  export ROVODEV="$ATLASSIAN_API" && \
  __export_secret_required EMAIL 'Atlassian API Token' email && \
  __export_secret_required ATLASSIAN_URL 'Atlassian API Token' url && \
  __secret_required GWS_CONTENT_READER_CREDENTIAL 'GCP Service Account - GWS Content Reader' credential >| "$HOME/.cache/gcp/gws-content-reader-key.json" && \
  [ -s "$HOME/.cache/gcp/gws-content-reader-key.json" ] && \
  chmod 600 "$HOME/.cache/gcp/gws-content-reader-key.json" && \
  export GWS_CONTENT_READER_CREDENTIALS="$HOME/.cache/gcp/gws-content-reader-key.json" && \
  trap '__cleanup_gcp_cache' EXIT; then
  _SECRETS_LOADED=1
  __profile_elapsed "$__load_start" "total secret load"
  echo "Secrets loaded."
else
  echo "Failed to load secrets from 1Password." >&2
  echo "  - If in a non-TTY/agent shell: run 'secret' once in an interactive herdr" >&2
  echo "    pane to populate the shared session cache (~/.cache/op/session)." >&2
  echo "  - Otherwise: ensure the 1Password app is unlocked and CLI integration is on." >&2
  # Clean up any partial state so retry is possible
  unset _SECRETS_LOADED
  __unset_secret_env
  __cleanup_gcp_cache
  return 1
fi

unset __SECRET_ITEMS_JSON __load_start
