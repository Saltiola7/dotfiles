#!/bin/bash
# secret — Load secrets from 1Password into the current shell session.
#
# This script is designed to be SOURCED, not executed:
#   . secret        (from interactive shell or agent session)
#   source secret   (equivalent)
#
# In interactive shells, just type 'secret' — the shell function wrapper
# defined in .common_profile will source this automatically.

# --- Guard: prevent execution as subprocess ---
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  echo "This script must be sourced, not executed."
  echo "Usage: . secret  OR  source secret"
  exit 1
fi

# --- Idempotency: skip if already loaded ---
if [ -n "$_SECRETS_LOADED" ]; then
  echo "Secrets already loaded."
  return 0
fi

# --- Local dependencies needed before prompting for 1Password auth ---
if ! command -v jq >/dev/null 2>&1; then
  echo "error: jq is required for batched secret loading." >&2
  return 1
fi

# --- Ensure a usable 1Password session (shared, cached, one Touch ID per restart) ---
# Sourcing op-session resolves a valid OP_SESSION token from: current env, the
# on-disk cache (~/.cache/op/session), or a fresh biometric mint (TTY only).
# Non-TTY agent shells inherit the token a TTY pane already cached.
if command -v op-session >/dev/null 2>&1; then
  . op-session || {
    echo "Failed to acquire 1Password session — see op-session guidance above." >&2
    return 1
  }
fi

# --- Helpers: bounded commands, profiling, and grouped 1Password extraction ---
__OP_TIMEOUT_SECONDS="${OP_TIMEOUT_SECONDS:-8}"
__SHELL_SECRETS_ITEM_ID="vjsfewbg2dzuatpwfmkqws5hle"
__SHELL_SECRETS_VAULT="${OP_SHELL_SECRETS_VAULT:-Automation}"

__run_with_timeout() {
  perl -e '
    use strict;
    use warnings;
    my $timeout = shift @ARGV;
    my $pid = fork();
    die "fork failed\n" unless defined $pid;
    if ($pid == 0) {
      exec @ARGV;
      exit 127;
    }
    local $SIG{ALRM} = sub {
      kill "TERM", $pid;
      select undef, undef, undef, 0.2;
      kill "KILL", $pid;
      exit 124;
    };
    alarm $timeout;
    waitpid($pid, 0);
    my $status = $?;
    exit 127 if $status == -1;
    exit(128 + ($status & 127)) if $status & 127;
    exit($status >> 8);
  ' "$__OP_TIMEOUT_SECONDS" "$@"
}

__profile_now_ms() {
  perl -MTime::HiRes=time -e 'printf "%.0f", time() * 1000'
}

__profile_log() {
  [ -n "${SECRET_PROFILE:-}" ] || return 0
  printf 'secret profile: %s\n' "$*" >&2
}

__profile_elapsed() {
  [ -n "${SECRET_PROFILE:-}" ] || return 0
  local start end label
  start="$1"
  label="$2"
  end="$(__profile_now_ms)"
  __profile_log "$label: $((end - start))ms"
}

__fetch_secret_bundle() {
  local start
  start="$(__profile_now_ms)"
  __SECRET_ITEMS_JSON="$(__run_with_timeout op item get "$__SHELL_SECRETS_ITEM_ID" --vault "$__SHELL_SECRETS_VAULT" --reveal --format json)" || {
    echo "error: 1Password item fetch failed or timed out." >&2
    return 1
  }

  printf '%s' "$__SECRET_ITEMS_JSON" | jq -e '
    .title == "Shell Secrets" and ((.fields // []) | type == "array")
  ' >/dev/null || {
    echo "error: failed to parse 1Password item JSON." >&2
    return 1
  }

  __profile_elapsed "$start" "1Password item fetch"
}

__fetch_secret_bundle_with_session_retry() {
  local OP_SESSION_FORCE_MINT

  __fetch_secret_bundle && return 0

  if [ -t 0 ] && command -v op-session >/dev/null 2>&1; then
    echo "Retrying with fresh 1Password session..." >&2
    OP_SESSION_FORCE_MINT=1
    . op-session && __fetch_secret_bundle
    return $?
  fi

  return 1
}

__project_secret_values() {
  local start projected name encoded val
  start="$(__profile_now_ms)"

  projected="$(printf '%s' "$__SECRET_ITEMS_JSON" | jq -er '
    . as $item |
    def field($label):
      ($item.fields // [] | map(select(.label == $label)) | first | .value) // "";

    {
      GEMINI_API_KEY: field("GEMINI_API_KEY"),
      GOOGLE_GENERATIVE_AI_API_KEY: field("GOOGLE_GENERATIVE_AI_API_KEY"),
      OPENAI_API_KEY: field("OPENAI_API_KEY"),
      DATABRICKS_HOST: field("DATABRICKS_HOST"),
      DATABRICKS_TOKEN: field("DATABRICKS_TOKEN"),
      AWS_PROFILE: field("AWS_PROFILE"),
      AWS_REGION: field("AWS_REGION"),
      __GCP_ENTERPRISE_SEO_TOOLS_CREDENTIAL: field("GCP_ENTERPRISE_SEO_TOOLS_CREDENTIAL"),
      GOOGLE_VERTEX_PROJECT: field("GOOGLE_VERTEX_PROJECT"),
      GOOGLE_VERTEX_LOCATION: field("GOOGLE_VERTEX_LOCATION"),
      CLICKHOUSE_HOST: field("CLICKHOUSE_HOST"),
      CLICKHOUSE_USER: field("CLICKHOUSE_USER"),
      CLICKHOUSE_PORT: field("CLICKHOUSE_PORT"),
      CLICKHOUSE_PASSWORD: field("CLICKHOUSE_PASSWORD"),
      SEMRUSH_API: field("SEMRUSH_API"),
      SEMRUSH_ENTERPRISE_API: field("SEMRUSH_ENTERPRISE_API"),
      PAGESPEED_API_KEY: field("PAGESPEED_API_KEY"),
      GCS_AKAMAI_ACCESS_KEY: field("GCS_AKAMAI_ACCESS_KEY"),
      GCS_AKAMAI_SECRET_KEY: field("GCS_AKAMAI_SECRET_KEY"),
      CLOCKIFY_API_KEY: field("CLOCKIFY_API_KEY"),
      GITHUB_PERSONAL_ACCESS_TOKEN_CLASSIC: field("GITHUB_PERSONAL_ACCESS_TOKEN_CLASSIC"),
      ATLASSIAN_API: field("ATLASSIAN_API"),
      EMAIL: field("EMAIL"),
      ATLASSIAN_URL: field("ATLASSIAN_URL"),
      __GWS_CONTENT_READER_CREDENTIAL: field("GWS_CONTENT_READER_CREDENTIAL")
    } as $values |
    ($values | to_entries | map(select(.value == "") | .key)) as $missing |
    if ($missing | length) > 0 then
      error("missing required projected secret values: \($missing | join(", "))")
    else
      $values | to_entries[] | [.key, (.value | @base64)] | @tsv
    end
  ')" || {
    echo "error: failed to project required secret values." >&2
    return 1
  }

  while IFS=$'\t' read -r name encoded; do
    val="$(printf '%s' "$encoded" | base64 -d)" || {
      echo "error: failed to decode projected secret value: $name" >&2
      return 1
    }
    case "$name" in
      __GCP_ENTERPRISE_SEO_TOOLS_CREDENTIAL|__GWS_CONTENT_READER_CREDENTIAL)
        printf -v "$name" '%s' "$val"
        ;;
      *)
        export "$name=$val"
        ;;
    esac
  done <<< "$projected"

  [ -n "$GEMINI_API_KEY" ] || return 1
  export GEMINI_DEEP_RESEARCH_API_KEY="$GEMINI_API_KEY"
  export CLAUDE_CODE_USE_BEDROCK=1
  export GOOGLE_CLOUD_PROJECT="$GOOGLE_VERTEX_PROJECT"
  export GOOGLE_PROJECT="$GOOGLE_VERTEX_PROJECT"
  export CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE="$HOME/.cache/gcp/enterprise-seo-tools-sa.json"
  export CLOUDSDK_ACTIVE_CONFIG_NAME=sa-dev-admin
  export AI_STUDIO_KEY="$GOOGLE_GENERATIVE_AI_API_KEY"
  export ROVODEV="$ATLASSIAN_API"

  __profile_elapsed "$start" "secret projection"
}

__unset_secret_env() {
  unset GEMINI_API_KEY \
        GEMINI_DEEP_RESEARCH_API_KEY \
        GOOGLE_GENERATIVE_AI_API_KEY \
        OPENAI_API_KEY \
        DATABRICKS_HOST \
        DATABRICKS_TOKEN \
        AWS_PROFILE \
        AWS_REGION \
        CLAUDE_CODE_USE_BEDROCK \
        GOOGLE_APPLICATION_CREDENTIALS \
        GOOGLE_VERTEX_PROJECT \
        GOOGLE_VERTEX_LOCATION \
        GOOGLE_CLOUD_PROJECT \
        GOOGLE_PROJECT \
        CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE \
        CLOUDSDK_ACTIVE_CONFIG_NAME \
        CLICKHOUSE_HOST \
        CLICKHOUSE_USER \
        CLICKHOUSE_PORT \
        CLICKHOUSE_PASSWORD \
        SEMRUSH_API \
        SEMRUSH_ENTERPRISE_API \
        PAGESPEED_API_KEY \
        AI_STUDIO_KEY \
        GCS_AKAMAI_ACCESS_KEY \
        GCS_AKAMAI_SECRET_KEY \
        CLOCKIFY_API_KEY \
        GITHUB_PERSONAL_ACCESS_TOKEN_CLASSIC \
        ATLASSIAN_API \
        ROVODEV \
        EMAIL \
        ATLASSIAN_URL \
        GWS_CONTENT_READER_CREDENTIALS
}

# --- GCP credential cleanup helper ---
# Mirrors .common_profile's cleanup: remove ephemeral SA files AND clear the
# env vars that point at them. CLOUDSDK_ACTIVE_CONFIG_NAME / CLOUDSDK_CORE_ACCOUNT
# must be cleared too — a surviving config pin with a deleted key file wedges
# every gcloud call ("Failed to load credential file" / non-interactive Reauth).
__cleanup_gcp_cache() {
  # Under herdr, sibling panes share these cache files. Exiting one pane must not
  # yank the SA file out from under still-open panes — let the herdr session
  # lifecycle own cleanup. Outside herdr, clean up normally.
  [ -n "$HERDR_ENV" ] && return 0
  rm -f "$HOME/.cache/gcp/enterprise-seo-tools-sa.json" \
       "$HOME/.cache/gcp/gws-content-reader-key.json" 2>/dev/null
  unset GOOGLE_APPLICATION_CREDENTIALS \
        GWS_CONTENT_READER_CREDENTIALS \
        CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE \
        CLOUDSDK_ACTIVE_CONFIG_NAME \
        CLOUDSDK_CORE_ACCOUNT
}

echo "Loading secrets from 1Password..."
__load_start="$(__profile_now_ms)"

if __fetch_secret_bundle_with_session_retry && \
  __project_secret_values && \
  mkdir -p "$HOME/.cache/gcp" && \
  printf '%s' "$__GCP_ENTERPRISE_SEO_TOOLS_CREDENTIAL" >| "$HOME/.cache/gcp/enterprise-seo-tools-sa.json" && \
  [ -s "$HOME/.cache/gcp/enterprise-seo-tools-sa.json" ] && \
  chmod 600 "$HOME/.cache/gcp/enterprise-seo-tools-sa.json" && \
  export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.cache/gcp/enterprise-seo-tools-sa.json" && \
  mkdir -p /tmp/sketchybar_clockify && \
  printf '%s' "$CLOCKIFY_API_KEY" >| /tmp/sketchybar_clockify/api_key && \
  chmod 600 /tmp/sketchybar_clockify/api_key && \
  printf '%s' "$__GWS_CONTENT_READER_CREDENTIAL" >| "$HOME/.cache/gcp/gws-content-reader-key.json" && \
  [ -s "$HOME/.cache/gcp/gws-content-reader-key.json" ] && \
  chmod 600 "$HOME/.cache/gcp/gws-content-reader-key.json" && \
  export GWS_CONTENT_READER_CREDENTIALS="$HOME/.cache/gcp/gws-content-reader-key.json" && \
  trap '__cleanup_gcp_cache' EXIT; then
  _SECRETS_LOADED=1
  __profile_elapsed "$__load_start" "total secret load"
  echo "Secrets loaded."
else
  echo "Failed to load secrets from 1Password." >&2
  echo "  - If in a non-TTY/agent shell: run 'secret' once in an interactive herdr" >&2
  echo "    pane to populate the shared session cache (~/.cache/op/session)." >&2
  echo "  - Otherwise: ensure the 1Password app is unlocked and CLI integration is on." >&2
  # Clean up any partial state so retry is possible
  unset _SECRETS_LOADED
  __unset_secret_env
  __cleanup_gcp_cache
  return 1
fi

unset __SECRET_ITEMS_JSON __GCP_ENTERPRISE_SEO_TOOLS_CREDENTIAL __GWS_CONTENT_READER_CREDENTIAL __load_start
