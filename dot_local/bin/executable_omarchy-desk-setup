#!/usr/bin/env bash
# Explicit setup for the Omarchy desk; no privileged work during chezmoi apply.
set -euo pipefail

if [[ ${1:-} != "smb" && ${1:-} != "input" && ${1:-} != "tailscale" && ${1:-} != "terminal" && ${1:-} != "always-on" ]]; then
  echo "Usage: omarchy-desk-setup {smb|input|tailscale|terminal|always-on}" >&2
  exit 2
fi
if [[ ! -t 0 ]]; then
  echo "Run this command in a terminal for sudo and SMB password prompts." >&2
  exit 1
fi

if [[ $1 == "always-on" ]]; then
  omarchy pkg add tailscale
  source_config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-host/logind.conf"
  target_config=/etc/systemd/logind.conf.d/60-omarchy-desk.conf
  if sudo test -f "$target_config" && ! sudo cmp -s "$source_config" "$target_config"; then
    sudo cp -a "$target_config" "$target_config.backup.$(date +%Y%m%d%H%M%S)"
  fi
  sudo install -Dm644 "$source_config" "$target_config"
  sudo systemctl reload systemd-logind.service
  sudo systemctl enable --now tailscaled.service
  sudo tailscale set --ssh
  echo 'On AC: closing the lid no longer suspends the machine. Idle does not suspend it.'
  echo 'Desktop auto-lock remains enabled; it does not stop the relay server or SSH.'
  printf 'From the Mac on Tailscale: ssh %s@%s\n' "$(id -un)" "$(tailscale ip -4)"
  echo 'SSH access follows your tailnet policy and may request browser verification.'
  echo 'After a reboot, the encrypted disk must be unlocked before services can start.'
  exit 0
fi

if [[ $1 == "tailscale" ]]; then
  omarchy pkg add tailscale
  sudo systemctl enable --now tailscaled.service
  sudo tailscale up
  exit 0
fi

if [[ $1 == "terminal" ]]; then
  omarchy pkg add kitty ttf-monofur-nerd
  mkdir -p "$HOME/.local/share/kitty"
  omarchy default terminal kitty
  exit 0
fi

if [[ $1 == "input" ]]; then
  omarchy pkg add wl-clipboard wtype
  omarchy pkg aur add synergy3-bin waynergy
  pacman -Q synergy3-bin waynergy wl-clipboard wtype
  systemctl --user daemon-reload
  systemctl --user enable omarchy-waynergy.service
  echo "Input-sharing packages installed. Configure Synergy 3 before starting it."
  echo "Run only one input-sharing client at a time."
  exit 0
fi

omarchy pkg add samba
share_config="${XDG_CONFIG_HOME:-$HOME/.config}/samba/smb.conf"
testparm -s "$share_config" >/dev/null
mkdir -p "$HOME/Shared"

# Preserve any existing system configuration before deploying the managed one.
if sudo test -f /etc/samba/smb.conf; then
  if ! sudo cmp -s "$share_config" /etc/samba/smb.conf; then
    sudo cp -a /etc/samba/smb.conf "/etc/samba/smb.conf.backup.$(date +%Y%m%d%H%M%S)"
  fi
fi
sudo install -Dm644 "$share_config" /etc/samba/smb.conf

share_user="$(id -un)"
if ! sudo pdbedit -L -u "$share_user" | cut -d: -f1 | rg -Fxq "$share_user"; then
  echo "Choose an SMB password for $share_user (never stored in the dotfiles)."
  sudo smbpasswd -a "$share_user"
fi
sudo systemctl enable --now smb.service
sudo systemctl restart smb.service
if command -v ufw >/dev/null; then
  # Permit the current private LAN only, plus the authenticated tailnet.
  read -r lan_interface lan_subnet < <(python3 - <<'PYLAN'
import ipaddress,json,subprocess
routes=json.loads(subprocess.check_output(['ip','-j','-4','route','show','default']))
device=next(r['dev'] for r in routes if r.get('dev') != 'tailscale0')
addresses=json.loads(subprocess.check_output(['ip','-j','-4','addr','show','dev',device]))
address=next(a for d in addresses for a in d['addr_info'] if a.get('scope')=='global')
subnet=ipaddress.ip_network(f"{address['local']}/{address['prefixlen']}",strict=False)
if not subnet.is_private: raise SystemExit('LAN is not private; configure access explicitly')
print(device,subnet)
PYLAN
  )
  [[ -n $lan_interface && -n $lan_subnet ]] || exit 1
  sudo ufw allow in on "$lan_interface" proto tcp from "$lan_subnet" to any port 445 comment 'Shared folder private LAN'
  sudo ufw allow in on tailscale0 proto tcp from 100.64.0.0/10 to any port 445 comment 'Shared folder Tailscale'
fi
echo "In Finder: Go > Connect to Server > smb://<this-laptop-IP>/Shared"
echo "Use username $share_user and the SMB password you chose."
