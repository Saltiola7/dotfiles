#!/bin/bash
# Launch new Citrix .ica sessions (citrix-ica-watch.service).
# Browsers write downloads atomically (temp + rename), so a rename-triggered
# run sees complete files; the settle delay is cheap insurance.
set -u
sleep 2
state_dir="$HOME/.local/state/ica-autolaunch"
state="$state_dir/processed"
mkdir -p "$state_dir"; touch "$state"
export DISPLAY="${DISPLAY:-:0}"
while IFS= read -r -d "" f; do
    key="$(basename "$f") $(stat -c %Y "$f" 2>/dev/null)"
    grep -qxF "$key" "$state" && continue
    setsid /opt/Citrix/ICAClient/wfica.sh "$f" >/dev/null 2>&1 &
    echo "$key" >> "$state"
done < <(find "$HOME/Downloads" -maxdepth 1 -name "*.ica" -print0 2>/dev/null)
tail -n 200 "$state" > "$state.t" && mv "$state.t" "$state"
