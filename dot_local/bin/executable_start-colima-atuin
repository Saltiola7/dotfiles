#!/bin/sh

state=/Volumes/ext/state
[ -f "$state/.dotfiles-ai-state" ] || exit 0
volume=${state%/state}
/sbin/mount | /usr/bin/grep -Fq " on $volume (apfs," || exit 1
for path in "$state/lima" "$state/colima" "$state/cache/colima"; do
    [ -d "$path" ] || exit 1
done
export LIMA_HOME="$state/lima"
export COLIMA_HOME="$state/colima"
export COLIMA_CACHE_HOME="$state/cache/colima"
export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
exec /opt/homebrew/bin/colima start -f
