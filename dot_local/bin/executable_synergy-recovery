#!/bin/bash
# Recover only the verified Synergy SecureSocket/multiplexer deadlock.
# macOS /bin/bash 3.2 and BSD awk; no network or clipboard probes.
set -u
export LC_ALL=C

classify_sample() {
    # A matching pair must be in two distinct thread call trees, dominate each
    # thread's samples, and belong to the expected bundled core and service.
    /usr/bin/awk -v expected_pid="$2" -v expected_parent="$3" -v app="$4" '
    function ordered(kind, depth, i, stage, name) {
        stage = 0
        for (i = 1; i <= depth; ++i) {
            if (!(i in frame)) continue
            name = frame[i]
            if (kind == 1) {
                if (stage == 0 && index(name,"SecureSocket::freeSSL(")) stage = 1
                else if (stage == 1 && index(name,"SocketMultiplexer::removeSocket(")) stage = 2
                else if (stage == 2 && index(name,"waitCondVar(")) stage = 3
                else if (stage == 3 && index(name,"__psynch_cvwait")) stage = 4
            } else {
                if (stage == 0 && index(name,"SocketMultiplexer::serviceThread(")) stage = 1
                else if (stage == 1 && index(name,"TCPSocket::serviceConnected(")) stage = 2
                else if (stage == 2 && index(name,"SecureSocket::doWrite(")) stage = 3
                else if (stage == 3 && index(name,"SecureSocket::secureWrite(")) stage = 4
                else if (stage == 4 && index(name,"mutex::lock(")) stage = 5
                else if (stage == 5 && index(name,"__psynch_mutexwait")) stage = 6
            }
        }
        return stage == (kind == 1 ? 4 : 6)
    }
    /^Process:/ {
        process = ($0 ~ /synergy-core \[[0-9]+\]/ && index($0,"[" expected_pid "]"))
    }
    /^Parent Process:/ {
        parent = ($0 ~ /synergy-service \[[0-9]+\]/ && index($0,"[" expected_parent "]"))
    }
    /^Path:/ { path=$0; sub(/^Path:[ \t]*/,"",path); binary=(path == app "/Contents/MacOS/synergy-core") }
    /^Call graph:/ { graph=1; saw_graph=1; next }
    graph && /^(Total number in stack|Sort by top of stack|Binary Images:)/ { graph=0; ended=1 }
    graph && /^[ \t]*[0-9]+[ \t]+Thread_[[:alnum:]]+/ {
        total=$1+0; thread=$2; sub(/:.*/,"",thread)
        for (i in frame) delete frame[i]
        next
    }
    graph && thread != "" && match($0,/[0-9]+[ \t]+/) {
        depth=RSTART; prefix=substr($0,1,depth-1)
        if (prefix !~ /^[ \t+!:|]*$/) next
        count=substr($0,RSTART,RLENGTH)+0
        name=substr($0,RSTART+RLENGTH)
        for (i in frame) if ((i + 0) >= depth) delete frame[i]
        frame[depth]=name
        if (count >= 100 && total >= 100 && count >= total*0.90) {
            if (ordered(1,depth)) closing[thread]=1
            if (ordered(2,depth)) writing[thread]=1
        }
    }
    END {
        if (!process || !parent || !binary || !saw_graph || !ended) exit 2
        for (a in closing) for (b in writing) if (a != b) exit 0
        exit 1
    }' "$1"
}

read_configuration() {
    local extra=""
    [[ -f "$1" ]] || return 1
    {
        IFS= read -r recovery_enabled && IFS= read -r app_path || return 1
        if IFS= read -r extra; then return 1; fi
    } <"$1"
    case "$recovery_enabled" in true|false) ;; *) return 1;; esac
    [[ "$app_path" == /*.app ]]
}

process_snapshot() { /bin/ps -ww -axo uid=,pid=,ppid=,lstart=,comm=; }

candidate_identity() {
    # ps may show a temporary synergy-core copy. Its exact same-user service
    # parent, GUI presence, and the sample Path must identify the app bundle.
    process_snapshot | /usr/bin/awk -v owner="$(/usr/bin/id -u)" -v app="$app_path" '
    $1 == owner {
        uid=$1; pid=$2; parent=$3; started=$4 " " $5 " " $6 " " $7 " " $8
        command=$0
        for (i=1;i<=8;i++) sub(/^[ \t]*[^ \t]+[ \t]*/,"",command)
        if (command == app "/Contents/MacOS/Synergy") gui=1
        if (command == app "/Contents/MacOS/synergy-service") service[pid]=started
        if (command ~ /(^|\/)synergy-core$/) {
            core[pid]=uid "|" pid "|" parent "|" started "|" command
            core_parent[pid]=parent
        }
    }
    END {
        if (!gui) exit
        for (pid in core) if (core_parent[pid] in service) {
            result=core[pid] "|" service[core_parent[pid]]; count++
        }
        if (count == 1) print result
    }'
}

atomic_write() {
    local destination="$1" temporary
    temporary=$(/usr/bin/mktemp "$state_dir/.write.XXXXXX") || return 1
    if ! /usr/bin/printf '%s\n' "$2" >"$temporary" || ! /bin/mv -f "$temporary" "$destination"; then
        /bin/rm -f "$temporary"
        return 1
    fi
}

current_time() { /bin/date +%s; }

set_status() { atomic_write "$state_dir/status" "$now $1 context=${SYNERGY_RECOVERY_CONTEXT:-manual} at=$(/bin/date -u +%Y-%m-%dT%H:%M:%SZ) ${observed_identity:-}"; }

log_event() {
    local size=0
    [[ ! -f "$state_dir/recovery.log" ]] || size=$(/usr/bin/wc -c <"$state_dir/recovery.log")
    if (( size >= 65536 )); then /bin/mv -f "$state_dir/recovery.log" "$state_dir/recovery.log.1"; fi
    /usr/bin/printf '%s %s\n' "$now" "$1" >>"$state_dir/recovery.log"
}

sample_core() {
    # File size limits bound diagnostics even if sampling output changes.
    local sampling watcher result timeout_file="$2.timeout"
    (ulimit -f 2048; exec /usr/bin/sample "$1" 2 5 -file "$2") >/dev/null 2>&1 &
    sampling=$!
    (
        /bin/sleep 8
        # A diagnostic child must still belong to this invocation at timeout.
        if [[ "$(/bin/ps -p "$sampling" -o ppid= | /usr/bin/awk '{$1=$1;print}')" == "$$" ]]; then
            : >"$timeout_file"
            /bin/kill -TERM "$sampling" 2>/dev/null || true
            /bin/sleep 1
            [[ "$(/bin/ps -p "$sampling" -o ppid= | /usr/bin/awk '{$1=$1;print}')" != "$$" ]] ||
                /bin/kill -KILL "$sampling" 2>/dev/null || true
        fi
    ) &
    watcher=$!
    wait "$sampling"; result=$?
    /bin/kill "$watcher" 2>/dev/null || true
    wait "$watcher" 2>/dev/null || true
    if [[ -f "$timeout_file" ]]; then /bin/rm -f "$timeout_file"; return 1; fi
    return "$result"
}

signal_core() { /bin/kill "-$1" "$2"; }

terminate_core() {
    local identity="$1" pid="$2"
    if ! signal_core TERM "$pid"; then set_status signal-failed; return 0; fi
    log_event "requested recovery of confirmed deadlocked core $pid with TERM"
    set_status recovery-requested
    /bin/sleep 2
    # A user quit or a changed PID/parent/start cancels escalation.
    if [[ "$(candidate_identity)" == "$identity" ]]; then
        now=$(current_time)
        atomic_write "$state_dir/cooldown" "$now" || return 1
        [[ "$(candidate_identity)" == "$identity" ]] || return 0
        if signal_core KILL "$pid"; then
            log_event "confirmed core $pid remained after TERM; requested KILL"
            set_status forced-recovery-requested
        else
            set_status signal-failed
        fi
    fi
}

check_once() {
    local identity previous_identity="" previous_time=0 cooldown=0 temporary rc pid parent age
    now=$(current_time)
    observed_identity=""
    if [[ "${recovery_enabled:-false}" != true ]]; then
        /bin/rm -f "$state_dir/pending"
        set_status disabled
        return 0
    fi
    identity=$(candidate_identity)
    if [[ -z "$identity" ]]; then
        /bin/rm -f "$state_dir/pending"
        set_status no-owned-core
        return 0
    fi
    observed_identity="$identity"
    pid=${identity#*|}; pid=${pid%%|*}
    parent=${identity#*|*|}; parent=${parent%%|*}
    temporary=$(/usr/bin/mktemp "$state_dir/.sample.XXXXXX") || return 1
    if ! sample_core "$pid" "$temporary" || [[ ! -s "$temporary" ]] ||
       (( $(/usr/bin/wc -c <"$temporary") > 2097152 )); then
        /bin/rm -f "$temporary" "$state_dir/pending"
        set_status sample-unavailable
        return 0
    fi
    classify_sample "$temporary" "$pid" "$parent" "$app_path"; rc=$?
    if (( rc != 0 )); then
        /bin/rm -f "$temporary" "$state_dir/pending"
        if (( rc == 1 )); then set_status checked-no-deadlock; else set_status sample-unrecognized; fi
        return 0
    fi
    if [[ "$(candidate_identity)" != "$identity" ]]; then
        /bin/rm -f "$temporary" "$state_dir/pending"
        set_status identity-changed
        return 0
    fi
    if [[ -f "$state_dir/cooldown" ]]; then read -r cooldown <"$state_dir/cooldown" || cooldown=0; fi
    case "$cooldown" in *[!0-9]*|"") cooldown=0;; esac
    age=$((now - cooldown))
    # A clock rollback must not bypass the minimum recovery cooldown.
    if (( cooldown > 0 && age < 300 )); then
        /bin/rm -f "$state_dir/pending"
        set_status cooldown
        return 0
    fi
    if [[ -f "$state_dir/pending" ]]; then
        { IFS= read -r previous_identity; IFS= read -r previous_time; } <"$state_dir/pending"
    fi
    case "$previous_time" in *[!0-9]*|"") previous_time=0;; esac
    age=$((now - previous_time))
    if [[ "$previous_identity" != "$identity" ]] || (( age < 30 || age > 180 )); then
        /bin/mv -f "$temporary" "$state_dir/suspect-sample.txt" || return 1
        atomic_write "$state_dir/pending" "$identity
$now" || return 1
        set_status suspect
        return 0
    fi
    /bin/mv -f "$temporary" "$state_dir/confirmed-sample.txt" || return 1
    # Persist the cooldown at intervention time, after sampling, before any
    # signal. Failure must never allow a recovery loop.
    now=$(current_time)
    atomic_write "$state_dir/cooldown" "$now" || return 1
    /bin/rm -f "$state_dir/pending"
    if [[ "$(candidate_identity)" != "$identity" ]]; then set_status identity-changed; return 0; fi
    terminate_core "$identity" "$pid"
}

main() {
    if [[ "${1:-}" == --classify-sample && $# == 5 ]]; then classify_sample "$2" "$3" "$4" "$5"; return $?; fi
    if [[ $# != 0 || "$(/usr/bin/uname -s)" != Darwin ]]; then
        echo "Usage: synergy-recovery (macOS only)" >&2
        return 2
    fi
    umask 077
    state_dir="$HOME/Library/Application Support/dotfiles/synergy-recovery"
    /bin/mkdir -p "$state_dir" || return 1
    /bin/chmod 700 "$state_dir" || return 1
    if ! read_configuration "$HOME/.config/synergy-recovery/config"; then
        now=$(current_time)
        /bin/rm -f "$state_dir/pending"
        set_status configuration-unavailable
        return 0
    fi
    # launchd serializes scheduled runs; this also excludes manual invocations.
    if ! /bin/mkdir "$state_dir/check.lock" 2>/dev/null; then
        local owner="" owner_start="" actual_start="" modified age
        if [[ -f "$state_dir/check.lock/pid" ]]; then
            { read -r owner; IFS= read -r owner_start; } <"$state_dir/check.lock/pid"
        fi
        case "$owner" in *[!0-9]*|"") owner="";; esac
        if [[ -n "$owner" ]]; then
            actual_start=$(/bin/ps -p "$owner" -o lstart= | /usr/bin/awk '{$1=$1;print}')
            [[ -z "$actual_start" || "$actual_start" != "$owner_start" ]] || return 0
        fi
        # Also wait out a just-created or partially written owner record.
        modified=$(/usr/bin/stat -f %m "$state_dir/check.lock") || return 0
        age=$(( $(current_time) - modified ))
        (( age > 60 )) || return 0
        /bin/rm -f "$state_dir/check.lock/pid"
        /bin/rmdir "$state_dir/check.lock" 2>/dev/null || return 0
        /bin/mkdir "$state_dir/check.lock" 2>/dev/null || return 0
    fi
    trap '/bin/rm -f "$state_dir/check.lock/pid"; /bin/rmdir "$state_dir/check.lock" 2>/dev/null' EXIT
    /usr/bin/printf '%s\n%s\n' "$$" "$(/bin/ps -p $$ -o lstart= | /usr/bin/awk '{$1=$1;print}')" >"$state_dir/check.lock/pid" || return 1
    trap 'exit 0' HUP INT TERM
    /bin/rm -f "$state_dir"/.sample.* "$state_dir"/.write.*
    check_once
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
