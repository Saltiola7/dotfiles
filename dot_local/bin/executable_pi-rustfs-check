#!/usr/bin/env python3
"""Isolated private S3/DVC roundtrip; credentials never enter command arguments."""
import argparse
import configparser
import json
import os
from pathlib import Path
import secrets
import shutil
import subprocess
import tempfile


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path, required=True)
    parser.add_argument("--dvc", type=Path, default=Path.home() / ".local/state/homelab-object-storage/dvc-client/bin/dvc")
    args = parser.parse_args()
    if args.config.is_symlink() or args.config.stat().st_mode & 0o077 or args.config.stat().st_uid != os.getuid():
        raise ValueError("Client configuration must be owner-private")
    cfg = json.loads(args.config.read_text())
    aws, dvc = shutil.which("aws"), str(args.dvc) if args.dvc.is_file() else None
    if not aws or not dvc:
        raise ValueError("Existing AWS CLI and DVC with S3 support are required")
    bucket = "dvc-probe-" + secrets.token_hex(8)
    with tempfile.TemporaryDirectory(prefix="pi-rustfs-dvc-") as temp:
        root = Path(temp)
        empty_config = root / "empty-aws-config"
        empty_config.touch(mode=0o600)
        env = {k: v for k, v in os.environ.items() if k in ("PATH", "LANG", "LC_ALL", "TERM")}
        env.update(HOME=str(root), XDG_CONFIG_HOME=str(root / "config"), AWS_ACCESS_KEY_ID=cfg["access_key"], AWS_SECRET_ACCESS_KEY=cfg["secret_key"], AWS_DEFAULT_REGION="us-east-1", AWS_CONFIG_FILE=str(empty_config), AWS_SHARED_CREDENTIALS_FILE=str(empty_config), AWS_EC2_METADATA_DISABLED="true", DVC_NO_ANALYTICS="1")
        prefix = [aws, "--endpoint-url", cfg["endpoint"], "s3api"]
        def run(*command: str) -> None:
            subprocess.run(command, cwd=root, env=env, check=True)
        run(*prefix, "create-bucket", "--bucket", bucket)
        try:
            run(dvc, "init", "--no-scm", "--quiet")
            run(dvc, "remote", "add", "--default", "probe", "s3://" + bucket)
            config = configparser.ConfigParser()
            config['remote "probe"'] = {"endpointurl": cfg["endpoint"], "access_key_id": cfg["access_key"], "secret_access_key": cfg["secret_key"], "region": "us-east-1"}
            local = root / ".dvc/config.local"
            with local.open("w") as stream:
                config.write(stream)
            local.chmod(0o600)
            payload = "Private DVC roundtrip " + secrets.token_hex(32) + "\n"
            (root / "probe.txt").write_text(payload)
            run(dvc, "add", "probe.txt")
            run(dvc, "push")
            (root / "probe.txt").unlink()
            shutil.rmtree(root / ".dvc/cache")
            run(dvc, "pull")
            if (root / "probe.txt").read_text() != payload:
                raise ValueError("DVC restored bytes differ")
            print("Private S3/DVC push and fresh-cache pull matched.")
        finally:
            # Delete only this uniquely generated scratch bucket and its test objects.
            run(aws, "--endpoint-url", cfg["endpoint"], "s3", "rb", "s3://" + bucket, "--force")


if __name__ == "__main__":
    os.umask(0o077)
    main()
