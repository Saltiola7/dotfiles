{{ if eq .chezmoi.arch "arm64" }}
{
  "machine_type": "omarchy-try",
  "architecture": "aarch64",
  "apps": [
    {
      "name": "pycharm",
      "command": "pycharm",
      "method": "archive",
      "version": "2026.2.3",
      "url": "https://download.jetbrains.com/python/pycharm-2026.2.3-aarch64.tar.gz",
      "sha256": "c1ac6b7440f4d8946241d602220e9db9afac75f41831ca21dc5168cdf3689d0e",
      "binary": "pycharm-*/bin/pycharm.sh",
      "gui": true
    },
    {
      "name": "rustdesk-bin",
      "command": "rustdesk",
      "method": "aur",
      "recipe": "rustdesk-bin",
      "dependencies": [
        "base-devel",
        "gtk3",
        "xdotool",
        "libxcb",
        "libxfixes",
        "libpulse",
        "libva",
        "libvdpau",
        "pam",
        "gst-plugins-base",
        "gst-plugin-pipewire"
      ]
    },
    {
      "name": "icaclient",
      "command": "wfica",
      "method": "aur",
      "recipe": "icaclient",
      "dependencies": [
        "base-devel",
        "alsa-lib",
        "curl",
        "gst-plugins-base-libs",
        "libc++",
        "libc++abi",
        "libsecret",
        "libvorbis",
        "libxaw",
        "libxml2-legacy",
        "libxp",
        "openssl",
        "speex",
        "webkit2gtk-4.1",
        "libsoup3"
      ]
    },
    {
      "name": "zen",
      "command": "zen",
      "method": "archive",
      "version": "1.24.2b",
      "url": "https://github.com/zen-browser/desktop/releases/download/1.24.2b/zen.linux-aarch64.tar.xz",
      "sha256": "8591434fcf498a836a32bc7314eb89fbdc4bdc8f03a2d735774b1ae69b6b21d5",
      "binary": "zen/zen",
      "gui": true
    }
  ]
}
