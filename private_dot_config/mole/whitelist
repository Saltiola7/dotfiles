# Mole whitelist — paths protected from `mo clean`
# Format: absolute paths (~ and $HOME expanded), globs supported
# Docs: https://github.com/tw93/Mole
# NOTE: Custom whitelist replaces Mole defaults, so we include them here

# Mole defaults (from DEFAULT_WHITELIST_PATTERNS)
~/Library/Caches/ms-playwright*
~/.cache/huggingface*
~/.m2/repository/*
~/.gradle/caches/*
