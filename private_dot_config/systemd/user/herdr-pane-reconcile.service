[Unit]
Description=Reconcile herdr panes with the mapped opencode sessions after restart
After=herdr.service graphical-session.target
Wants=herdr.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 20
ExecStart=/home/tis/.local/bin/herdr-pane-reconcile

[Install]
WantedBy=graphical-session.target
