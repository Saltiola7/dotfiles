[Unit]
Description=Mac keyboard and mouse through Waynergy
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/omarchy-waynergy-test {{ default "192.168.100.95" (get . "waynergy_server") }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
