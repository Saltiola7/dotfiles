{{ if eq .machine_type "omarchy-try" -}}
# Self-hosted atuin server (container on this machine).
sync_address = "http://127.0.0.1:8888"
{{ else -}}
# Fleet self-host is parked until the VM is bridged or the port is forwarded.
sync_address = "https://api.atuin.sh"
{{ end -}}
auto_sync = true
sync_frequency = "10m"
filter_mode = "global"
workspaces = true
secrets_filter = true
