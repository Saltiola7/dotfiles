{{ if eq .machine_type "fedora-server" -}}
auto_sync = false
{{ else -}}
auto_sync = true
{{ end -}}
{{ if or (eq .machine_type "omarchy") (eq .machine_type "omarchy-try") (eq .machine_type "mac-mini") -}}
# Self-hosted atuin server: container on the try-omarchy VM, reachable
# fleet-wide over Tailscale (NAT-proof). The VM's Tailscale address is
# the stable entrypoint for every machine.
sync_address = "http://100.109.164.98:8888"
{{ else -}}
sync_address = {{ .atuin_sync_address | quote }}
{{ end -}}
sync_frequency = "10m"
filter_mode = "global"
workspaces = true
secrets_filter = true
enter_accept = true
network_connect_timeout = 2
network_timeout = 5
history_filter = [
  '^atuin key(?:\s|$)',
  '^gh auth token(?:\s|$)',
  '^op read(?:\s|$)',
  '(?i)(?:password|secret|token|api[_-]?key)\s*=',
]

[stats]

[keys]

[sync]
records = true

[preview]

[daemon]
enabled = false
