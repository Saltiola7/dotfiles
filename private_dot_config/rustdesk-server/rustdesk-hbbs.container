[Unit]
Description=Private RustDesk hbbs
Requires=tailscaled.service
After=tailscaled.service network-online.target

[Container]
Image=docker.io/rustdesk/rustdesk-server@sha256:8ecdab65deb7c84652a626380e31d11a8f1fbafd97916d57f95c20628f943c00
ContainerName=omarchy-rustdesk-hbbs
Exec=hbbs -r @TAILSCALE_IP@:21117 -k _
Volume=/var/lib/rustdesk-server:/root
PublishPort=@TAILSCALE_IP@:21115:21115/tcp
PublishPort=@TAILSCALE_IP@:21116:21116/tcp
PublishPort=@TAILSCALE_IP@:21116:21116/udp

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
ExecStartPre=/usr/bin/bash -c 'for i in {1..60}; do /usr/bin/tailscale ip -4 | /usr/bin/grep -q "^100[.]" && exit 0; sleep 2; done; exit 1'

[Install]
WantedBy=multi-user.target
