// Side-project oh-my-openagent override template.
// Drop this in any project as `.opencode/oh-my-openagent.jsonc`,
// then run with: secret && opencode
//
// Routes Sisyphus + Prometheus to Moonshot Kimi K2.6 directly,
// keeping work-only providers (Bedrock, Vertex) out of the chain.
//
// Requires: MOONSHOT_API_KEY env var (your `secret` injects this from 1Password).
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "model_fallback": true,
  "agents": {
    "sisyphus": {
      "model": "moonshotai/kimi-k2-turbo-preview",
      "fallback_models": [
        // Add openai/gpt-5.5 here if you want personal OpenAI as fallback
        { "model": "openai/gpt-5.5", "reasoningEffort": "high" }
      ]
    },
    "prometheus": {
      "model": "moonshotai/kimi-k2-turbo-preview",
      "fallback_models": [
        { "model": "openai/gpt-5.5", "reasoningEffort": "high" }
      ]
    },
    "atlas": {
      "model": "moonshotai/moonshot-v1-32k"
    },
    "explore": {
      "model": "openai/gpt-5.4-mini"
    },
    "librarian": {
      "model": "openai/gpt-5.4-mini"
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "high"
    }
  }
}
