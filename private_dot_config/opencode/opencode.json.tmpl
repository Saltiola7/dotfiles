{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "models": {
        "gpt-5.6-sol": {
          "variants": {
            "medium": { "reasoningEffort": "medium" }
          }
        },
        "gpt-5.6-terra": {
          "variants": {
            "medium": { "reasoningEffort": "medium" }
          }
        }
      }
    },
    "amazon-bedrock": {
      "options": {
        "region": "us-west-2",
        "profile": "BedrockDeveloperAccess-302432775606"
      },
      "models": {
        "global.anthropic.claude-opus-4-8": {
          "variants": {
            "medium": {
              "reasoningConfig": {
                "type": "adaptive",
                "maxReasoningEffort": "medium",
                "display": "summarized"
              }
            }
          }
        },
        "global.anthropic.claude-sonnet-5": {
          "variants": {
            "medium": {
              "reasoningConfig": {
                "type": "adaptive",
                "maxReasoningEffort": "medium",
                "display": "summarized"
              }
            }
          }
        }
      }
    },
    "google": {},
    "moonshotai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Moonshot (Kimi)",
      "options": {
        "baseURL": "https://api.moonshot.ai/v1",
        "apiKey": "{env:MOONSHOT_API_KEY}"
      },
      "models": {
        "kimi-k2-turbo-preview": {
          "name": "Kimi K2 Turbo (preview)",
          "limit": { "context": 256000, "output": 8192 }
        },
        "moonshot-v1-32k": {
          "name": "Moonshot v1 32k",
          "limit": { "context": 32000, "output": 4096 }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "mistralai/devstral-small-2-2512": {
          "name": "Devstral Small 2 (MLX 4bit, local)",
          "limit": { "context": 65536, "output": 8192 }
        },
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B (MLX 4bit, local)",
          "limit": { "context": 32768, "output": 16384 }
        }
      }
    },
    "headroom": {
      "npm": "@ai-sdk/anthropic",
      "name": "Headroom → Bedrock (compressed)",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "dummy"
      },
      "models": {
        "global.anthropic.claude-sonnet-4-6": {
          "name": "Sonnet 4.6 (compressed)",
          "limit": { "context": 200000, "output": 64000 }
        },
        "global.anthropic.claude-opus-4-8": {
          "name": "Opus 4.8 (compressed)",
          "limit": { "context": 200000, "output": 32000 }
        }
      }
    },
    "headroom-lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom → LM Studio (compressed)",
      "options": {
        "baseURL": "http://127.0.0.1:8788/v1"
      },
      "models": {
        "mistralai/devstral-small-2-2512": {
          "name": "Devstral Small 2 (compressed, local)",
          "limit": { "context": 65536, "output": 8192 }
        },
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B (compressed, local)",
          "limit": { "context": 32768, "output": 16384 }
        }
      }
    }
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium"
    },
    "build": { "disable": true }
  },
  "default_agent": "plan",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-terra",
  "plugin": ["@dietrichgebert/ponytail"]
}
