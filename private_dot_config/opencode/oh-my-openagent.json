{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "model_fallback": true,
  "sisyphus_agent": {
    "default_builder_enabled": true,
    "replace_plan": false
  },
  "agents": {
    "sisyphus": {
      "model": "amazon-bedrock/global.anthropic.claude-opus-4-7",
      "reasoningEffort": "max",
      "fallback_models": [
        { "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1", "reasoningEffort": "max" },
        { "model": "google-vertex/claude-opus-4-7@default", "reasoningEffort": "max" },
        { "model": "google-vertex/claude-opus-4-6@default", "reasoningEffort": "max" }
      ]
    },
    "prometheus": {
      "model": "amazon-bedrock/global.anthropic.claude-opus-4-7",
      "reasoningEffort": "max",
      "fallback_models": [
        { "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1", "reasoningEffort": "max" },
        { "model": "google-vertex/claude-opus-4-7@default", "reasoningEffort": "max" },
        { "model": "openai/gpt-5.5", "reasoningEffort": "high" }
      ]
    },
    "atlas": {
      "model": "google-vertex/claude-sonnet-4-6@default",
      "fallback_models": [
        { "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1" },
        { "model": "google-vertex/claude-opus-4-7@default" },
        { "model": "openai/gpt-5.5", "reasoningEffort": "medium" }
      ]
    },
    "metis": {
      "model": "google-vertex/claude-sonnet-4-6@default",
      "fallback_models": [
        { "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1", "reasoningEffort": "max" },
        { "model": "google-vertex/claude-opus-4-7@default", "reasoningEffort": "max" },
        { "model": "openai/gpt-5.5", "reasoningEffort": "high" }
      ]
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "medium",
      "allow_non_gpt_model": true,
      "fallback_models": [
        { "model": "amazon-bedrock/global.anthropic.claude-opus-4-7", "reasoningEffort": "max" },
        { "model": "google-vertex/claude-opus-4-7@default", "reasoningEffort": "max" },
        { "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1", "reasoningEffort": "max" }
      ]
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "high",
      "fallback_models": [
        { "model": "amazon-bedrock/global.anthropic.claude-opus-4-7", "reasoningEffort": "max" },
        { "model": "google-vertex/claude-opus-4-7@default", "reasoningEffort": "max" },
        { "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1", "reasoningEffort": "max" }
      ]
    },
    "momus": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "xhigh",
      "fallback_models": [
        { "model": "amazon-bedrock/global.anthropic.claude-opus-4-7", "reasoningEffort": "max" },
        { "model": "google-vertex/claude-opus-4-7@default", "reasoningEffort": "max" },
        { "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1", "reasoningEffort": "max" }
      ]
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "medium",
      "fallback_models": [
        { "model": "google-vertex/gemini-3.1-pro-preview" },
        { "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1" },
        { "model": "openai/gpt-5-nano" }
      ]
    },
    "explore": {
      "model": "google-vertex/claude-haiku-4-5@20251001",
      "fallback_models": [
        { "model": "openai/gpt-5.4-mini" },
        { "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1" }
      ]
    },
    "librarian": {
      "model": "google-vertex/claude-haiku-4-5@20251001",
      "fallback_models": [
        { "model": "openai/gpt-5.4-mini" },
        { "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1" }
      ]
    },
    "sisyphus-junior": {
      "model": "google-vertex/claude-sonnet-4-6@default",
      "fallback_models": [
        { "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1" },
        { "model": "google-vertex/claude-opus-4-7@default" }
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "amazon-bedrock/global.anthropic.claude-opus-4-7",
      "reasoningEffort": "max",
      "fallback_models": [
        { "model": "google-vertex/claude-opus-4-7@default", "reasoningEffort": "max" },
        { "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1", "reasoningEffort": "max" }
      ]
    },
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "xhigh",
      "fallback_models": [
        { "model": "amazon-bedrock/global.anthropic.claude-opus-4-7", "reasoningEffort": "max" },
        { "model": "google-vertex/claude-opus-4-7@default", "reasoningEffort": "max" }
      ]
    },
    "deep": {
      "model": "amazon-bedrock/global.anthropic.claude-opus-4-7",
      "reasoningEffort": "max",
      "fallback_models": [
        { "model": "openai/gpt-5.5", "reasoningEffort": "high" },
        { "model": "google-vertex/claude-opus-4-7@default", "reasoningEffort": "max" }
      ]
    },
    "artistry": {
      "model": "amazon-bedrock/global.anthropic.claude-opus-4-7",
      "reasoningEffort": "max",
      "fallback_models": [
        { "model": "google-vertex/claude-opus-4-7@default", "reasoningEffort": "max" }
      ]
    },
    "quick": {
      "model": "google-vertex/claude-haiku-4-5@20251001",
      "fallback_models": [
        { "model": "openai/gpt-5.4-mini" },
        { "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1" }
      ]
    },
    "unspecified-low": {
      "model": "google-vertex/claude-haiku-4-5@20251001",
      "fallback_models": [
        { "model": "openai/gpt-5.4-mini" }
      ]
    },
    "unspecified-high": {
      "model": "amazon-bedrock/global.anthropic.claude-opus-4-7",
      "reasoningEffort": "max",
      "fallback_models": [
        { "model": "google-vertex/claude-opus-4-7@default", "reasoningEffort": "max" },
        { "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1", "reasoningEffort": "max" }
      ]
    },
    "writing": {
      "model": "google-vertex/claude-sonnet-4-6@default",
      "fallback_models": [
        { "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1" }
      ]
    }
  }
}
