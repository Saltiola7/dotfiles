#!/bin/bash
# mbp-omarchy keyboard layers: keyd tap/hold layers (Caps=HYPER, space=MEH,
# right-Cmd=arrows, hold-/=\) plus the Touch Bar fn policy (media by default,
# F1-F12 on fn). Idempotent; needs a terminal so sudo can prompt.
{{ if and (eq .machine_type "omarchy") (hasPrefix "mbp-omarchy" .chezmoi.hostname) -}}
[[ -t 0 ]] || { echo "[mbp-keyboard] Run from a terminal so sudo can prompt." >&2; exit 0; }
set -euo pipefail

if ! command -v keyd >/dev/null; then
    sudo pacman -S --needed --noconfirm keyd
fi

sudo tee /etc/keyd/mbp.conf > /dev/null << 'KEYD'
# mbp built-in keyboard tap/hold layers; deployed by chezmoi (MKL-001).
# External keyboards (ZSA over USB) never match [ids] and stay untouched.
# keyd resolves below XKB: j k l ; are raw keycodes = Colemak n e i o.
# ids are PREFIX matches (no globs): the :89b7fedc uid pins the keyboard
# node only -- bare 05ac:0341 would also grab the SPI trackpad. If keyd
# upgrades change the uid, find the new one in: journalctl -u keyd
[ids]
05ac:0341:89b7fedc

[main]
capslock = layer(hyper)
space = overloadt(meh, space, 200)
rightmeta = layer(arrows)
# Tap/hold symbol keys (hold emits shift+key through the tis keymap):
slash = timeout(slash, 200, S-slash)                          # / tap, ? hold
grave = timeout(grave, 200, S-grave)                          # | tap, ~ hold
102nd = timeout(102nd, 200, macro(102nd 102nd 102nd))         # ` tap, ``` hold
comma = timeout(comma, 200, S-comma)                          # , tap, < hold
dot = timeout(dot, 200, S-dot)                                # . tap, > hold

[hyper:C-M-A-S]

[meh:C-A-S]

[arrows]
j = left
k = down
l = up
; = right
KEYD

sudo systemctl enable --now keyd
sudo systemctl restart keyd

# Touch Bar policy: tiny-dfr owns the rendered strip — media keys by
# default, F1-F12 while fn is held. /etc/tiny-dfr/config.toml merges over
# the packaged template, so a single key override is enough. fnmode 3
# pairs with it (media-first keycodes; fn+F-row types F1-F12).
sudo mkdir -p /etc/tiny-dfr
printf '%s\n' "# Managed by chezmoi (MKL-001); merges over the packaged template." \
    "MediaLayerDefault = true" | sudo tee /etc/tiny-dfr/config.toml > /dev/null
sudo systemctl restart tiny-dfr

# Keycode side of the same policy (live-verified: 1 is F-keys-first).
printf '%s\n' "options hid_apple fnmode=3" | sudo tee /etc/modprobe.d/hid-apple.conf > /dev/null
echo 3 | sudo tee /sys/module/hid_apple/parameters/fnmode > /dev/null

echo "[mbp-keyboard] applied; keyd owns tap/hold from the next keystroke."
{{ else -}}
exit 0
{{ end -}}
