{{- $name := promptStringOnce . "name" "Your full name" "" -}}
{{- $email := promptStringOnce . "email" "Your email address" "" -}}
{{- $machineType := promptStringOnce . "machine_type" "Machine type (macbook/mac-mini/lmsh/remote-workspace/fedora-workstation/omarchy/fedora-server)" "macbook" -}}
{{- $atuinSyncAddress := promptStringOnce . "atuin_sync_address" "Atuin sync address" "https://api.atuin.sh" -}}

sourceDir = {{ if eq $machineType "mac-mini" }}"/Volumes/ext/git/Personal/dotfiles"{{ else }}{{ .chezmoi.sourceDir | quote }}{{ end }}
encryption = "age"
[edit]
    hardlink = {{ if eq $machineType "mac-mini" }}false{{ else }}true{{ end }}
[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1agtsh9jxq93rdl68mtjmf9g8qwp3da89xdvkdculnv894aepd4us4m5rdm"

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    machine_type = {{ $machineType | quote }}
{{ with default "" (get . "git_identity_routing_file") }}
    git_identity_routing_file = {{ . | quote }}
{{ end }}
{{ if eq $machineType "omarchy" }}
    waynergy_client_name = {{ default "omarchy" (get . "waynergy_client_name") | quote }}
{{ end }}
{{ if eq $machineType "mac-mini" }}
    synergy_recovery_enabled = {{ if hasKey . "synergy_recovery_enabled" }}{{ .synergy_recovery_enabled }}{{ else }}true{{ end }}
    synergy_app_path = {{ default "/Applications/Synergy.app" (get . "synergy_app_path") | quote }}
{{ end }}
{{ if and (eq .chezmoi.os "darwin") (or (eq $machineType "mac-mini") (eq $machineType "macbook")) }}
    smb_reconnect_enabled = {{ if hasKey . "smb_reconnect_enabled" }}{{ .smb_reconnect_enabled }}{{ else }}true{{ end }}
{{ end }}
    atuin_sync_address = {{ $atuinSyncAddress | quote }}
{{ if eq $machineType "fedora-server" }}
    homelab_target = {{ default "" (get . "homelab_target") | quote }}
{{ end }}
