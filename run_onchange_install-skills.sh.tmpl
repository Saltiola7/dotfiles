#!/bin/bash
# Installs agent skills from upstream GitHub repos.
# Re-runs when the lockfile changes (new skill added or source updated).
#
# skill-lock hash: {{ include "dot_agents/dot_skill-lock.json" | sha256sum }}

set -e

if ! command -v npx &>/dev/null; then
    echo "[chezmoi] npx not found. Cannot install skills." >&2
    exit 1
fi

echo "[chezmoi] Installing agent skills from upstream..."

npx -y skills add vercel-labs/skills --skill find-skills -g --all
npx -y skills add JuliusBrussee/caveman -g --all
npx -y skills add marimo-team/marimo-pair -g --all

echo "[chezmoi] Agent skills installed."
