#!/bin/bash
# Installs agent skills from upstream GitHub repos.
# The selected skills below are the declarative manifest. The skills CLI owns
# ~/.agents/.skill-lock.json; chezmoi must not manage that mutable runtime file.

set -euo pipefail

if ! command -v npx &>/dev/null; then
    echo "[chezmoi] npx not found. Cannot install skills." >&2
    exit 1
fi

echo "[chezmoi] Installing agent skills from upstream..."

npx -y skills add vercel-labs/skills --skill find-skills -g --agent opencode -y
npx -y skills add JuliusBrussee/caveman \
    --skill caveman \
    --skill caveman-commit \
    --skill caveman-help \
    --skill caveman-review \
    -g --agent opencode -y
npx -y skills add marimo-team/marimo-pair --skill marimo-pair -g --agent opencode -y

echo "[chezmoi] Agent skills installed."
