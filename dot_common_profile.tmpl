# Common Shell Configuration (Bash & Zsh)
# Shared PATH, environment variables, and aliases for both shells and all machines

# --- PATH Setup ---

# Homebrew (must be early for brew commands to work)
export PATH="/opt/homebrew/bin:$PATH"

# Local bin
export PATH="{{ .chezmoi.homeDir }}/.local/bin:$PATH"

# Cargo / Rust
export PATH="{{ .chezmoi.homeDir }}/.cargo/bin:$PATH"

# .NET tools
export PATH="{{ .chezmoi.homeDir }}/.dotnet/tools:$PATH"

# Volta (Node version manager)
export VOLTA_HOME="{{ .chezmoi.homeDir }}/.volta"
export PATH="$VOLTA_HOME/bin:$PATH"

# NPM global
if [ -z "$INTELLIJ_ENVIRONMENT_READER" ]; then
    if command -v npm &> /dev/null; then
        export PATH="$(npm config get prefix)/bin:$PATH"
    fi
fi

# Ruby
export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
export PATH="/opt/homebrew/lib/ruby/gems/4.0.0/bin:$PATH"

# Homebrew PHP
export PATH="/opt/homebrew/opt/php@8.2/bin:$PATH"
export PATH="/opt/homebrew/opt/php@8.2/sbin:$PATH"

# Homebrew Postgres
export PATH="/opt/homebrew/opt/postgresql@16/bin:$PATH"
export PATH="/opt/homebrew/opt/postgresql@17/bin:$PATH"
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# LM Studio CLI
export PATH="$PATH:{{ .chezmoi.homeDir }}/.cache/lm-studio/bin"

# Antigravity
export PATH="{{ .chezmoi.homeDir }}/.antigravity/antigravity/bin:$PATH"

# Abctl
export PATH="$PATH:{{ .chezmoi.homeDir }}/abctl"

# JetBrains Toolbox
export PATH="$PATH:{{ .chezmoi.homeDir }}/Library/Application Support/JetBrains/Toolbox/scripts"

# Modular / Mojo
export MODULAR_HOME="{{ .chezmoi.homeDir }}/.modular"
export PATH="{{ .chezmoi.homeDir }}/.modular/pkg/packages.modular.com_mojo/bin:$PATH"

# Google Cloud SDK (shell-aware: zsh needs .zsh.inc, bash needs .bash.inc)
if [ -n "$ZSH_VERSION" ]; then
    [ -f "{{ .chezmoi.homeDir }}/google-cloud-sdk/path.zsh.inc" ] && . "{{ .chezmoi.homeDir }}/google-cloud-sdk/path.zsh.inc"
else
    [ -f "{{ .chezmoi.homeDir }}/google-cloud-sdk/path.bash.inc" ] && . "{{ .chezmoi.homeDir }}/google-cloud-sdk/path.bash.inc"
fi
export USE_GKE_GCLOUD_AUTH_PLUGIN=True

# KeePassXC
export PATH="$PATH:/Applications/KeePassXC.app/Contents/MacOS/"

# Pkg Config
export PKG_CONFIG_PATH="/opt/homebrew/opt/openblas/lib/pkgconfig:$PKG_CONFIG_PATH"

# --- Aliases ---
alias vim='nvim'
alias python='python3'
alias py='python3'

# AWS SSO refresh (uses the launchd wrapper so SketchyBar's countdown
# updates immediately and STS is probed first to skip unnecessary
# browser pops). See docs/specs/aws_creds.md.
alias awslogin='~/.local/bin/aws-sso-refresh BedrockDeveloperAccess-302432775606'

# Screaming Frog
alias sf='/Applications/Screaming\ Frog\ SEO\ Spider.app/Contents/MacOS/ScreamingFrogSEOSpiderLauncher'
export PATH="$PATH:/Applications/Screaming Frog SEO Spider.app/Contents/MacOS/"


# ClickHouse
alias ch="clickhouse client --host \"\$(op read 'op://Personal/ClickHouse Cloud/host')\" --secure --password"

# --- Environment Variables ---

# Carapace completion bridges
export CARAPACE_BRIDGES="zsh,fish,bash,inshellisense"

# --- GCP credential hygiene ---
# Clean up STALE SA key state from previous sessions (e.g. shell killed via
# SIGKILL where the EXIT trap couldn't fire). Runs at every shell startup —
# before secret().
#
# CRITICAL: do NOT delete a freshly-provisioned key. `mise run shell`/`flow`/etc.
# materialize the SA file via setup-sa and inject GOOGLE_APPLICATION_CREDENTIALS,
# THEN spawn an interactive bash which sources this file. If startup cleanup
# unconditionally rm'd the file, it would delete the very credential the parent
# task just created — leaving the env var pointing at a missing file (the exact
# failure mode that broke `mise run shell` + kubectl/gke-gcloud-auth-plugin).
#
# Rule:
#   - If GOOGLE_APPLICATION_CREDENTIALS is set AND the file EXISTS → a parent
#     provisioned it on purpose. Leave file + env vars untouched.
#   - If the env var is set but the file is MISSING → genuine stale state from a
#     dead session. Unset the env vars (so SDKs fall back to ADC and gcloud uses
#     its on-disk config) but there is nothing to rm.
#   - If no env var is set → best-effort rm of any orphaned cache files.
#
# Why unset the CLOUDSDK_* vars too: the `secret` script pins gcloud to the
# sa-dev-admin named config (CLOUDSDK_ACTIVE_CONFIG_NAME) + file override. A
# surviving pin with a missing file makes every gcloud call (and the
# gke-gcloud-auth-plugin, which shells out to `gcloud config config-helper`)
# fail with "Failed to load credential file". Clearing them lets gcloud resolve
# its on-disk active config normally.
__cleanup_gcp_cache() {
  # Under herdr, sibling panes share the SA cache files; a single pane's
  # startup/exit must not delete them out from under still-open panes. Let the
  # herdr session lifecycle own cleanup. Outside herdr, clean up normally.
  [ -n "$HERDR_ENV" ] && return 0

  local sa="$HOME/.cache/gcp/enterprise-seo-tools-sa.json"
  local gws="$HOME/.cache/gcp/gws-content-reader-key.json"

  if [ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]; then
    if [ -f "$GOOGLE_APPLICATION_CREDENTIALS" ]; then
      # Parent provisioned a live credential — do not touch it.
      return 0
    fi
    # Env points at a missing file → stale. Unset, do not rm.
    unset GOOGLE_APPLICATION_CREDENTIALS \
          GWS_CONTENT_READER_CREDENTIALS \
          CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE \
          CLOUDSDK_ACTIVE_CONFIG_NAME \
          CLOUDSDK_CORE_ACCOUNT
    return 0
  fi

  # No env var set → remove any orphaned cache files from a dead session.
  rm -f "$sa" "$gws" 2>/dev/null
  unset GWS_CONTENT_READER_CREDENTIALS \
        CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE \
        CLOUDSDK_ACTIVE_CONFIG_NAME \
        CLOUDSDK_CORE_ACCOUNT
}
__cleanup_gcp_cache

# --- Secrets (lazy-loaded via 1Password CLI) ---
# Run 'secret' to load all secrets into the current shell session.
# Secrets are cached in memory — only one biometric prompt per session.
# Implementation lives in ~/.local/bin/secret (source-able script).
secret() { . "$HOME/.local/bin/secret"; }

# Shell startup must stay auth-free. `secret` is intentionally manual so Herdr
# restore storms cannot fan out into many concurrent 1Password prompts.
